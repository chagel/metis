#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  puts "\n== Installing pi packages =="
  # The MCP connector bridge. Keep the version in sync with
  # docker/pi-runtime/Dockerfile and lib/tasks/e2b.rake.
  if system("pi list 2>/dev/null | grep -q 'pi-mcp-adapter@2.7.0'")
    puts "pi-mcp-adapter already installed."
  else
    system! "pi", "install", "npm:pi-mcp-adapter@2.7.0"
  end

  puts "\n== Installing xurl (X connector MCP bridge) =="
  # Keep the version in sync with Dockerfile.dev,
  # docker/pi-runtime/Dockerfile, lib/tasks/e2b.rake, and daytona.rake.
  # Best-effort: the X connector is optional, so a failed download warns
  # instead of aborting setup.
  bin_dir = File.expand_path("~/.local/bin")
  FileUtils.mkdir_p(bin_dir)
  if system("command -v xurl >/dev/null 2>&1") || File.executable?(File.join(bin_dir, "xurl"))
    puts "xurl already installed."
  else
    os = `uname -s`.strip
    arch = { "x86_64" => "x86_64", "arm64" => "arm64", "aarch64" => "arm64" }[`uname -m`.strip]
    url = "https://github.com/xdevplatform/xurl/releases/download/v1.2.2/xurl_#{os}_#{arch}.tar.gz"
    if %w[Darwin Linux].include?(os) && arch && system("curl -fsSL #{url} | tar -xz -C #{bin_dir} xurl")
      puts "xurl installed to #{bin_dir} — make sure it's on PATH."
    else
      puts "xurl install skipped/failed — the X connector needs it on PATH (#{url})."
    end
  end
  FileUtils.install "docker/pi-runtime/xurl-mcp", File.join(bin_dir, "xurl-mcp"), mode: 0o755

  # puts "\n== Copying sample files =="
  # unless File.exist?("config/database.yml")
  #   FileUtils.cp "config/database.yml.sample", "config/database.yml"
  # end

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
