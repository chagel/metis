# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files, but keep the committed reference templates.
/.env*
!/.env.example
!/.env.deploy.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key
# Per-environment credential keys (e.g. credentials:edit -e production).
/config/credentials/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore local Claude Code settings (personal, not shared).
/.claude/settings.local.json

# Skills are sourced per-checkout (vendored / team-managed via DB), not
# vendored in-repo — except the repo-authored ones whitelisted below.
/.pi/skills/*
/.claude/skills/
!/.pi/skills/writing-spec/
!/.pi/skills/refresh-metis-docs/
!/.pi/skills/reviewing-code/

# Local design mockups — kept on the author's machine, not shared in-repo.
/docs/mockups/

# Ignore key files for decrypting credentials and more.
/config/credentials/*.key


# Private planning doc (untracked, kept local)
PLAN.md
