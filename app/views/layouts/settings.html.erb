<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <%= render "layouts/head" %>

  <body class="<%= class_names("app-shell", "hotwire-native": hotwire_native_app?) %>">
    <div class="app" data-controller="sidebar">
      <button type="button" class="sidebar-toggle"
              data-action="click->sidebar#toggle"
              aria-label="<%= t('.open_menu') %>" title="<%= t('.open_menu') %>">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7"
             stroke-linecap="round" aria-hidden="true">
          <path d="M2.5 4h11M2.5 8h11M2.5 12h11"/>
        </svg>
      </button>
      <div class="sidebar-backdrop" data-action="click->sidebar#close" aria-hidden="true"></div>
      <%= render "settings/sidebar" %>
      <%# Mirror the chat layout: sidebar nav swaps the right pane
          inside the same turbo-frame, so navigating between sections
          keeps the settings sidebar mounted. %>
      <turbo-frame id="main" data-turbo-action="advance">
        <%= yield %>
        <%# Flash lives inside the frame so a frame-scoped redirect
            (form save → re-render the same section) re-renders it.
            position:fixed takes it out of flow regardless of parent. %>
        <% if notice || alert %>
          <div class="flash-toast"
               data-controller="flash"
               data-action="mouseenter->flash#pause mouseleave->flash#resume">
            <% if notice %><div class="flash notice"><%= notice %></div><% end %>
            <% if alert %><div class="flash alert"><%= alert %></div><% end %>
          </div>
        <% end %>
      </turbo-frame>
    </div>
  </body>
</html>
