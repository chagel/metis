<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t('.title') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Metis">
    <meta name="application-name" content="Metis">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#f4f2ee">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      // Apply the saved color scheme before paint — no flash.
      (function () {
        var theme = localStorage.getItem("metisTheme") ||
          (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
        // Mirror --bg so browser chrome / PWA status bar matches the theme.
        document.querySelector('meta[name="theme-color"]').content =
          theme === "dark" ? "#0e1014" : "#f4f2ee";
      })();
    </script>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">

    <%= preload_link_tag asset_path("figtree-latin.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= class_names("auth-shell", "hotwire-native": hotwire_native_app?) %>">
    <main class="auth">
      <div class="auth-brand">
        <span class="auth-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 18.5V7l7 6.5 7-6.5v11.5"/>
          </svg>
        </span>
        <span class="auth-word"><%= t('.brand') %></span>
      </div>

      <% if notice %><div class="flash notice" role="status"><%= notice %></div><% end %>
      <% if alert %><div class="flash alert" role="alert"><%= alert %></div><% end %>

      <div class="auth-card">
        <%= yield %>
      </div>
    </main>
  </body>
</html>
