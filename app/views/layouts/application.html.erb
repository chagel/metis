<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <%= render "layouts/head" %>

  <body class="<%= class_names("auth-shell", "hotwire-native": hotwire_native_app?) %>">
    <main class="auth">
      <div class="auth-brand">
        <span class="auth-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 18.5V7l7 6.5 7-6.5v11.5"/>
          </svg>
        </span>
        <span class="auth-word"><%= t('.brand') %></span>
      </div>

      <% if notice %><div class="flash notice" role="status"><%= notice %></div><% end %>
      <% if alert %><div class="flash alert" role="alert"><%= alert %></div><% end %>

      <div class="auth-card">
        <%= yield %>
      </div>
    </main>
  </body>
</html>
