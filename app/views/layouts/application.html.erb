<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Metis" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Metis">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      // Apply the saved color scheme before paint — no flash.
      (function () {
        var saved = localStorage.getItem("metisTheme");
        document.documentElement.dataset.theme =
          saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      })();
    </script>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= preload_link_tag asset_path("figtree-latin.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="auth-shell">
    <main class="auth">
      <div class="auth-brand">
        <span class="auth-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 18.5V7l7 6.5 7-6.5v11.5"/>
          </svg>
        </span>
        <span class="auth-word">Metis</span>
      </div>

      <% if notice %><div class="flash notice" role="status"><%= notice %></div><% end %>
      <% if alert %><div class="flash alert" role="alert"><%= alert %></div><% end %>

      <div class="auth-card">
        <%= yield %>
      </div>
    </main>
  </body>
</html>
