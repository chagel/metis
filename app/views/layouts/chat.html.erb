<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <%= render "layouts/head" %>

  <%= tag.body(**chat_body_attrs) do %>
    <%# Subscribe the whole layout to user-level broadcasts so sidebar
        turn-status updates arrive even when viewing a different
        conversation. %>
    <%= turbo_stream_from current_user %>
    <%# Team-level broadcasts (e.g. the "new shared conversation" dot) reach
        every member currently active in this team. %>
    <%= turbo_stream_from current_team unless current_team.personal? %>
    <div class="app<%= " sidebar-collapsed" if nav_default_collapsed? %>"
         data-controller="sidebar" data-sidebar-section-value="<%= controller_name %>">
      <button type="button" class="sidebar-toggle"
              data-action="click->sidebar#toggle"
              aria-label="<%= t('.open_menu') %>" title="<%= t('.open_menu') %>">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7"
             stroke-linecap="round" aria-hidden="true">
          <path d="M2.5 4h11M2.5 8h11M2.5 12h11"/>
        </svg>
      </button>
      <div class="sidebar-backdrop" data-action="click->sidebar#close" aria-hidden="true"></div>
      <%= render "conversations/sidebar" %>
      <%# Sidebar conversation links target this frame, so picking a
          conversation swaps only the main pane and the sidebar keeps
          its scroll/paginated state. `advance` updates the URL so
          back/forward and refresh still work. Forms that need a full
          page reload (e.g. creating a new conversation, since the
          sidebar must pick up the new row) break out with
          `data-turbo-frame="_top"`. %>
      <turbo-frame id="main" data-turbo-action="advance">
        <%= yield %>
      </turbo-frame>
    </div>

    <% if notice || alert %>
      <div class="flash-toast"
           data-controller="flash"
           data-flash-delay-value="<%= flash[:undo_archive_id] ? 6000 : 3500 %>"
           data-action="mouseenter->flash#pause mouseleave->flash#resume">
        <% if notice %>
          <div class="flash notice">
            <%= notice %>
            <% if flash[:undo_archive_id] %>
              <%= button_to t('.undo'),
                    unarchive_conversation_path(flash[:undo_archive_id]),
                    method: :post,
                    class: "flash-undo",
                    form: { class: "flash-undo-form", data: { turbo_frame: "_top" } } %>
            <% end %>
          </div>
        <% end %>
        <% if alert %><div class="flash alert"><%= alert %></div><% end %>
      </div>
    <% end %>
  <% end %>
</html>
