<head>
  <title><%= content_for(:title) || t('.title') %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Metis">
  <meta name="application-name" content="Metis">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="theme-color" content="#f4f2ee">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <script>
    // Apply the color scheme before paint — no flash. Server-saved
    // preference wins (so it follows the user across devices); the
    // sidebar toggle still writes localStorage for instant flips.
    (function () {
      var server = <%= raw current_user&.theme.to_json %>;
      if (server === "system") localStorage.removeItem("metisTheme");
      else if (server) localStorage.setItem("metisTheme", server);
      var saved = localStorage.getItem("metisTheme");
      function apply(theme) {
        document.documentElement.dataset.theme = theme;
        // Mirror --bg so browser chrome / PWA status bar matches the theme.
        document.querySelector('meta[name="theme-color"]').content =
          theme === "dark" ? "#0e1014" : "#f4f2ee";
      }
      var media = matchMedia("(prefers-color-scheme: dark)");
      apply(saved || (media.matches ? "dark" : "light"));
      // Follow live OS light/dark flips while in "system" mode.
      media.addEventListener("change", function (e) {
        if (!localStorage.getItem("metisTheme")) apply(e.matches ? "dark" : "light");
      });
    })();
  </script>

  <%= yield :head %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">
  <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">

  <%= preload_link_tag asset_path("figtree-latin.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>

  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
