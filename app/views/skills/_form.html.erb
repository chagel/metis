<%= form_with model: skill, url: skill.persisted? ? skill_path(skill) : skills_path, class: "conn-form" do |f| %>
  <% if skill.errors.any? %>
    <div class="flash error"><%= skill.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="field">
    <%= f.label :slug %>
    <%= f.text_field :slug, placeholder: t(".slug_placeholder"), autocomplete: "off" %>
    <p class="field-hint"><%= t(".slug_hint_html") %></p>
  </div>

  <div class="field">
    <%= f.label :description %>
    <%= f.text_field :description,
          placeholder: t(".description_placeholder"),
          autocomplete: "off" %>
    <p class="field-hint"><%= t(".description_hint") %></p>
  </div>

  <div class="field">
    <%= label_tag "skill_skill_md", t(".skill_md_label") %>
    <%= text_area_tag "skill[skill_md]",
          skill.skill_md_content || Skill::DEFAULT_SKILL_MD,
          id: "skill_skill_md", rows: 18 %>
    <p class="field-hint"><%= t(".skill_md_hint_html") %></p>
  </div>

  <label class="field-check">
    <%= f.check_box :enabled %>
    <span><%= t(".enabled") %></span>
  </label>

  <div class="form-actions">
    <%= f.submit(skill.persisted? ? t(".save_skill") : t(".create_skill"), class: "btn btn-primary") %>
  </div>
<% end %>
