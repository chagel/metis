<%# Managers edit a skill; members see it read-only. %>
<%= content_tag(team_manager? ? :a : :div, class: "conn-row",
      href: (team_manager? ? edit_skill_path(skill) : nil)) do %>
  <div class="conn-main">
    <div class="conn-name"><%= skill.slug %></div>
    <% if skill.description.present? %>
      <div class="conn-sub"><%= skill.description %></div>
    <% end %>
  </div>
  <span class="skill-badge<%= ' off' unless skill.enabled? %>">
    <%= skill.enabled? ? t(".enabled") : t(".disabled") %>
  </span>
<% end %>
