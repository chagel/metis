<% if @repo_skills.any? %>
  <div class="conn-list">
    <% @repo_skills.each do |listing| %>
      <div class="conn-row">
        <div style="flex:1; min-width:0">
          <div class="conn-name"><%= listing.slug %></div>
          <div class="conn-desc"><%= truncate(listing.description.to_s, length: 140) %></div>
        </div>
        <span class="badge"><%= t(".built_in") %></span>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="pane-empty">
    <p><%= t(".empty") %></p>
    <p class="form-hint"><%= t(".empty_hint_html") %></p>
  </div>
<% end %>
