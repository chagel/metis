<% if @skills.any? %>
  <div class="conn-list">
    <% @skills.each do |skill| %>
      <%= render "skill", skill: skill %>
    <% end %>
  </div>
<% else %>
  <div class="pane-empty">
    <% if team_manager? %>
      <p><%= t(".empty_manager") %></p>
      <%= link_to t(".create_a_skill"), new_skill_path, class: "btn btn-primary" %>
    <% else %>
      <p><%= t(".empty_member") %></p>
    <% end %>
  </div>
<% end %>
