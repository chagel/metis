<% content_for :title, t(".title") %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title"><%= t(".title") %></h1>
    <div style="flex:1"></div>
    <%= link_to t("common.cancel"), skills_path, class: "btn btn-ghost" %>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <%= form_with url: import_skills_path, method: :post, local: true, class: "conn-form" do |f| %>
        <div class="field">
          <%= f.label :url, t(".github_source") %>
          <%= f.text_field :url, autofocus: true,
                placeholder: t(".url_placeholder") %>
          <p class="field-hint"><%= t(".url_hint_html") %></p>
        </div>

        <div style="display:flex; gap:0.5rem;">
          <%= f.submit t("common.import"), class: "btn btn-primary" %>
          <%= link_to t(".browse_marketplace"), skills_path(tab: "marketplace"), class: "btn btn-ghost" %>
        </div>
      <% end %>
    </div>
  </div>
</main>
