<% content_for :title, @blob.filename.to_s %>

<header class="preview-header">
  <%= link_to conversation_path(@message.conversation), class: "preview-back" do %>
    <span class="preview-back-arrow" aria-hidden="true">←</span>
    <span class="preview-action-label"><%= t('.back') %></span>
  <% end %>
  <h1 class="preview-title"><%= @blob.filename %></h1>

  <% if @previewer.preview_modes.size > 1 %>
    <nav class="preview-modes" aria-label="<%= t('.view_mode') %>">
      <% @previewer.preview_modes.each do |mode| %>
        <%= link_to mode.to_s.capitalize,
                    artifact_preview_path(@blob.signed_id, mode: mode),
                    class: "preview-mode#{' is-on' if @mode == mode}" %>
      <% end %>
    </nav>
  <% end %>

  <% if @partial == "previewers/html_full" %>
    <button type="button" class="preview-fs"
            data-action="click->fullscreen#enter">
      <span class="preview-action-label"><%= t('.fullscreen') %></span>
    </button>
  <% end %>

  <% if @can_share %>
    <div class="share" data-controller="share"
         data-share-copied-value="<%= t('artifact_shares.panel.copied') %>">
      <button type="button" class="preview-share-btn"
              data-action="click->share#toggle"
              title="<%= t('.share') %>" aria-label="<%= t('.share') %>">
        <span class="preview-action-label"><%= t('.share') %></span>
      </button>
      <%= render "artifact_shares/panel", blob: @blob, share: @share %>
    </div>
  <% end %>

  <%= link_to rails_blob_path(@blob, disposition: "attachment"),
              class: "preview-download" do %>
    <span class="preview-action-label"><%= t('.download') %></span>
  <% end %>
</header>

<main class="preview-body">
  <% if @partial %>
    <%= render @partial, previewer: @previewer, blob: @blob %>
  <% else %>
    <p class="preview-none"><%= t('.no_preview') %></p>
  <% end %>
</main>
