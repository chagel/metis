<%# locals: (pagy:, query:, filter:, kind:)
    Kept separate from browse pagination so their targets cannot cross. %>
<% if pagy&.next %>
  <div id="convos-search-sentinel"
       class="convos-sentinel"
       data-conversation-search-target="sentinel"
       data-url="<%= search_conversations_path(q: query, filter: filter, kind: kind, page: pagy.next) %>">
    <span class="convos-loading" aria-hidden="true"><%= t('conversations.convo_sentinel.loading') %></span>
  </div>
<% end %>
