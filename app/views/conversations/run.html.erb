<% content_for :title, @conversation.display_title %>

<main class="chat">
  <%= turbo_stream_from @conversation %>

  <header class="chat-head">
    <div style="flex:1; min-width:0">
      <h1 class="chat-title">
        <span id="<%= dom_id(@conversation, :title) %>"><%= @conversation.display_title %></span>
      </h1>
      <div class="chat-sub">
        <span><%= @workflow_run.trigger_summary %></span>
        <%= render "workflow_runs/meta", run: @workflow_run %>
      </div>
    </div>
    <div class="chat-actions">
      <%= link_to "Open transcript",
            conversation_path(@conversation, view: "transcript"),
            class: "btn btn-ghost btn-sm" %>
    </div>
  </header>

  <%# Current state up top with the header; the totals strip inside the
      timeline is sticky-bottom, so the summary stays in view while the
      timeline scrolls. %>
  <div class="wf-run-status-top"><%= render "workflow_runs/run_status", run: @workflow_run %></div>

  <div class="stream">
    <div class="wf-tl-wrap">
      <%# The gate card renders inline, under the step it blocks; the whole
          timeline is one broadcast region, so it stays live. %>
      <%= render "workflow_runs/timeline", run: @workflow_run, conversation: @conversation %>
    </div>
  </div>
</main>
