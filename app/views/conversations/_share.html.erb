<%# Inline access panel for the chat header: who can see this chat, as an
    access ladder — team (in-app, read-only) and public link — each a row
    with a state switch. Re-rendered whole on every toggle (Turbo Stream
    and full-page fallback both reuse this partial). %>
<%# can_manage: owner controls (switches). A read-only team viewer gets
    the copyable link only. %>
<% can_manage = local_assigns.fetch(:can_manage, true) %>
<div id="<%= dom_id(conversation, :share) %>"
     class="share-panel"
     data-share-target="panel"
     data-shared="<%= conversation.shared? %>">
  <% if can_manage && !conversation.team.personal? %>
    <div class="access-row">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="5.5" cy="5" r="2.3"/><path d="M1.5 13.5c0-2.2 1.8-4 4-4s4 1.8 4 4"/>
        <circle cx="11.5" cy="5.5" r="1.9"/><path d="M11 9.6c1.9.2 3.5 1.9 3.5 3.9"/>
      </svg>
      <div class="access-text">
        <span class="access-title"><%= t('.team_access') %></span>
        <span class="access-desc"><%= t('.team_access_desc') %></span>
      </div>
      <%= button_to visibility_conversation_path(conversation), method: :patch,
            class: "access-switch#{" on" if conversation.visibility_team?}",
            role: "switch", "aria-checked": conversation.visibility_team?.to_s,
            "aria-label": t('.team_access'),
            form: { data: { turbo_stream: true } } do %>
        <span class="access-knob"></span>
      <% end %>
    </div>
  <% end %>

  <% if can_manage %>
    <div class="access-row">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6.5 9.5a3 3 0 0 0 4.4.2l2.2-2.2a3 3 0 0 0-4.2-4.2L7.7 4.5"/>
        <path d="M9.5 6.5a3 3 0 0 0-4.4-.2L2.9 8.5a3 3 0 0 0 4.2 4.2l1.2-1.2"/>
      </svg>
      <div class="access-text">
        <span class="access-title"><%= t('.shared_link') %></span>
        <span class="access-desc"><%= t('.shared_link_desc') %></span>
      </div>
      <%= button_to share_conversation_path(conversation),
            method: conversation.shared? ? :delete : :post,
            class: "access-switch#{" on" if conversation.shared?}",
            role: "switch", "aria-checked": conversation.shared?.to_s,
            "aria-label": t('.public_link'),
            form: { data: { turbo_stream: true } } do %>
        <span class="access-knob"></span>
      <% end %>
    </div>
  <% end %>

  <% if conversation.shared? %>
    <div class="share-panel-row">
      <input type="text"
             class="share-panel-url"
             readonly
             value="<%= shared_conversation_url(token: conversation.share_token) %>"
             data-share-target="url"
             data-action="focus->share#selectAll">
      <button type="button"
              class="share-panel-copy"
              data-action="click->share#copy"
              data-share-target="copyButton"><%= t('.copy') %></button>
    </div>
  <% end %>
</div>
