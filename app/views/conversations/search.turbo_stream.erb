<%# Endless-scroll response for search results: append the next page's
    rows and swap the search sentinel for a fresh one (more pages) or
    remove it (last page). %>
<%= turbo_stream.append "convos-search-list",
      partial: "conversations/search_result",
      collection: @search_results, as: :conversation %>

<% if @search_pagy.next %>
  <%= turbo_stream.replace "convos-search-sentinel",
        partial: "conversations/search_sentinel",
        locals: { pagy: @search_pagy, query: @query,
                  filter: @sidebar_filter, kind: @sidebar_kind } %>
<% else %>
  <%= turbo_stream.remove "convos-search-sentinel" %>
<% end %>
