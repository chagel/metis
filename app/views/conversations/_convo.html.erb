<%# One row in the sidebar conversation list. Targets the #main
    turbo-frame so picking a conversation swaps only the right pane —
    the sidebar (and its scroll/pagination state) stays put. Inline
    rename lives on the show page's h1, not here, so this row remains
    a pure navigation link.

    The .convo-running dot is also appended / removed live via
    ChatBroadcaster on the user's Turbo stream — see chat.html.erb. %>
<%= link_to conversation,
      id: dom_id(conversation),
      class: "convo#{' on' if conversation == @conversation}",
      data: { conversation_filter_target: "item",
              active_link_target: "link",
              turbo_frame: "main",
              title: conversation.display_title } do %>
  <%# In the Team scope the list spans the whole team, so show whose
      conversation each row is. %>
  <% if @sidebar_filter == "team" %>
    <%= avatar_for conversation.user, size: 18, css: "convo-avatar" %>
  <% end %>
  <span class="tt" id="<%= dom_id(conversation, :sidebar_title) %>"><%= conversation.display_title %></span>
  <% if (run = conversation.workflow_run) %>
    <%= render "workflow_runs/sidebar_pill", conversation: conversation, run: run %>
  <% end %>
  <% if conversation.turn_in_progress? %>
    <span class="convo-running" id="<%= dom_id(conversation, :running) %>" aria-label="Running"></span>
  <% end %>
<% end %>
