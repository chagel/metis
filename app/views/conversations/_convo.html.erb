<%# One row in the sidebar conversation list. Targets the #main
    turbo-frame so picking a conversation swaps only the right pane —
    the sidebar (and its scroll/pagination state) stays put. Inline
    rename lives on the show page's h1, not here, so this row remains
    a pure navigation link.

    The .convo-running dot is also appended / removed live via
    ChatBroadcaster on the user's Turbo stream — see chat.html.erb. %>
<%= link_to conversation,
      id: dom_id(conversation),
      class: "convo#{' on' if conversation == @conversation}",
      data: { active_link_target: "link",
              turbo_frame: "main" } do %>
  <%# Attribution only where it informs: the Team tab spans the whole
      team, and any row someone else has spoken in. The Me/Starred tabs
      list the viewer's own conversations — a solo row needs no avatar. %>
  <% if @sidebar_filter == "team" || conversation.participants.many? %>
    <% participants = conversation.participants %>
    <span class="convo-avatars">
      <% participants.first(3).each_with_index do |participant, index| %>
        <%= avatar_for participant, size: 18, css: "convo-avatar#{' convo-avatar--stack' if index.positive?}" %>
      <% end %>
      <% if participants.size > 3 %>
        <span class="convo-avatar-overflow">+<%= participants.size - 3 %></span>
      <% end %>
    </span>
  <% end %>
  <span class="tt" id="<%= dom_id(conversation, :sidebar_title) %>"><%= conversation.display_title %></span>
  <% if (run = conversation.workflow_run) %>
    <%= render "workflow_runs/sidebar_pill", conversation: conversation, run: run %>
  <% elsif conversation.routine %>
    <span class="convo-routine" title="<%= t('.routine_source', name: conversation.routine.name) %>"
          aria-label="<%= t('.routine_source', name: conversation.routine.name) %>">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="8" cy="8" r="6"/><path d="M8 4.5V8l2.5 1.5"/>
      </svg>
    </span>
  <% end %>
  <% if conversation.turn_in_progress? %>
    <span class="convo-running" id="<%= dom_id(conversation, :running) %>" aria-label="<%= t('.running') %>"></span>
  <% end %>
<% end %>
