<% content_for :title, t('.title') %>

<main class="chat">
  <header class="chat-head archived-head">
    <div>
      <h1 class="chat-title"><%= t('.heading') %></h1>
      <div class="chat-sub">
        <span><%= t('.count', count: @archived_conversations.size) %></span>
      </div>
    </div>
  </header>

  <div class="stream">
    <div class="archived-list">
      <% if @archived_conversations.any? %>
        <% @archived_conversations.each do |conversation| %>
          <div id="<%= dom_id(conversation, :archived) %>" class="archived-row">
            <%= link_to conversation.display_title,
                  conversation_path(conversation),
                  class: "archived-title",
                  data: { turbo_frame: "_top" } %>
            <span class="archived-meta">
              <%= t('.archived_ago', time: time_ago_in_words(conversation.archived_at)) %>
            </span>
            <%= button_to t('common.restore'),
                  unarchive_conversation_path(conversation),
                  method: :post,
                  class: "archived-restore",
                  form: { data: { turbo_frame: "_top" } } %>
          </div>
        <% end %>
      <% else %>
        <div class="convos-empty"><%= t('.empty') %></div>
      <% end %>
    </div>
  </div>
</main>
