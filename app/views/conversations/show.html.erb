<% content_for :title, @conversation.display_title %>
<% workflow_run = @conversation.workflow_run %>

<main class="chat" data-controller="chat"
      data-chat-anchor-value="<%= "message_#{params[:turn].to_i}" if params[:turn].present? %>">
  <%= turbo_stream_from @conversation %>

  <header class="chat-head">
    <div style="flex:1; min-width:0">
      <% if @read_only %>
        <h1 class="chat-title">
          <span id="<%= dom_id(@conversation, :title) %>"><%= @conversation.display_title %></span>
        </h1>
        <div class="chat-sub">
          <span><%= t('.shared_by', name: @conversation.user.display_label) %></span>
          <%= render "routine_tag", conversation: @conversation %>
          <%= render "context_meter", conversation: @conversation %>
        </div>
      <% else %>
        <h1 class="chat-title"
            data-controller="conversation-title"
            data-conversation-title-url-value="<%= conversation_path(@conversation) %>">
          <span id="<%= dom_id(@conversation, :title) %>"
                data-conversation-title-target="text"
                data-action="click->conversation-title#edit"><%= @conversation.display_title %></span>
          <input class="chat-title-input"
                 type="text"
                 data-conversation-title-target="input"
                 data-action="keydown->conversation-title#keydown blur->conversation-title#save"
                 hidden />
        </h1>
        <div class="chat-sub">
          <span><%= t('.started_ago', time: time_ago_in_words(@conversation.created_at)) %></span>
          <%= render "routine_tag", conversation: @conversation %>
          <%= render "context_meter", conversation: @conversation %>
        </div>
      <% end %>
    </div>
    <div class="chat-actions">
      <% if workflow_run %>
        <%= link_to conversation_path(@conversation), class: "btn btn-ghost btn-sm" do %>
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor"
               stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="4" cy="4" r="1.7"/><circle cx="4" cy="12" r="1.7"/>
            <path d="M4 5.7v4.6M8.5 4h5M8.5 12h5"/>
          </svg>
          <%= t('.workflow') %>
        <% end %>
      <% end %>
      <%# The share panel is available to read-only viewers too, so they can
          copy the public link; owner-only controls (revoke/create, archive)
          are gated on can_manage / @read_only. %>
      <% if !@conversation.archived? && (!@read_only || @conversation.shared?) %>
        <div class="share" data-controller="share" data-share-copied-value="<%= t('conversations.share.copied') %>">
          <button type="button"
                  class="chat-action"
                  data-action="click->share#toggle"
                  title="<%= t('.share_conversation') %>"
                  aria-label="<%= t('.share_conversation') %>">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="3.5" r="1.75"/>
              <circle cx="4" cy="8" r="1.75"/>
              <circle cx="12" cy="12.5" r="1.75"/>
              <path d="M5.5 7.1l5-2.7"/>
              <path d="M5.5 8.9l5 2.7"/>
            </svg>
          </button>
          <%= render "conversations/share", conversation: @conversation, can_manage: !@read_only %>
        </div>
      <% end %>

      <% unless @read_only || @conversation.archived? %>
        <%= render "conversations/star", conversation: @conversation %>
        <%= button_to archive_conversation_path(@conversation),
              method: :post,
              class: "chat-action",
              title: t('.archive_conversation'),
              aria: { label: t('.archive_conversation') },
              form: { data: { turbo_frame: "_top" } } do %>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3.25" width="12" height="3" rx="1"/>
            <path d="M3 6.25v6.5a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-6.5"/>
            <path d="M6.5 9h3"/>
          </svg>
        <% end %>
      <% end %>
    </div>
  </header>

  <% if @conversation.archived? && !@read_only %>
    <div class="archived-banner" role="status">
      <svg class="archived-banner-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor"
           stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="3.25" width="12" height="3" rx="1"/>
        <path d="M3 6.25v6.5a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-6.5"/>
        <path d="M6.5 9h3"/>
      </svg>
      <span class="archived-banner-text"><%= t('.archived_banner') %></span>
      <%= button_to t('common.restore'),
            unarchive_conversation_path(@conversation),
            method: :post,
            class: "archived-banner-action",
            form: { data: { turbo_frame: "_top" } } %>
    </div>
  <% end %>

  <% if @conversation.forked? && !@read_only %>
    <div class="fork-banner" role="status">
      <svg class="fork-banner-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor"
           stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="4" cy="4" r="1.6"/>
        <circle cx="4" cy="12" r="1.6"/>
        <circle cx="12" cy="6.5" r="1.6"/>
        <path d="M4 5.6v4.8"/>
        <path d="M4 8h4a4 4 0 0 0 4-4"/>
      </svg>
      <span class="fork-banner-text">
        <% if (origin = @conversation.forked_from_conversation) %>
          <%= t('.forked_from_html', link: link_to(origin.display_title, origin, class: "fork-banner-link")) %>
        <% else %>
          <%= t('.forked_from_other') %>
        <% end %>
      </span>
    </div>
  <% end %>

  <div class="stream" data-chat-target="scroll">
    <div id="messages" class="thread" data-chat-target="messages">
      <%# A shared (read-only) view hides the whole activity block —
          reasoning and tool calls — matching the public share template. %>
      <%= render partial: "messages/message", collection: @messages,
            as: :message, locals: { hide_activity: @read_only, forkable: !@read_only } %>
    </div>
    <% if workflow_run %>
      <div class="thread"><%= render "workflow_runs/gate", run: workflow_run %></div>
    <% end %>
  </div>

  <button type="button" class="scroll-to-bottom"
          data-chat-target="scrollButton"
          data-action="click->chat#jumpToBottom"
          aria-label="<%= t('.jump_to_latest') %>">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 6l4 4 4-4"/>
    </svg>
    <span class="scroll-to-bottom-label scroll-to-bottom-label--default"><%= t('.jump_to_latest') %></span>
    <span class="scroll-to-bottom-label scroll-to-bottom-label--new"><%= t('.new_messages') %></span>
  </button>

  <% if @read_only %>
    <div class="readonly-note">
      <%= t('.read_only_note', name: @conversation.user.display_label) %>
    </div>
  <% elsif workflow_run&.active? %>
    <%= render "workflow_runs/run_status", run: workflow_run %>
  <% else %>
    <%= render "composer", conversation: @conversation %>
  <% end %>
</main>
