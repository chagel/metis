<%# The model pi resolved, where it ran, and its context-window usage.
    The element id is stable so ChatJob can repaint it after each turn. %>
<% model = conversation.agent_model %>
<% runtime = conversation.runtime_state %>
<% usage = conversation.context_usage %>
<% window = usage["contextWindow"].to_i %>
<span id="<%= dom_id(conversation, :context) %>" class="ctx-group">
  <% if model["name"].present? %>
    <span class="tag" title="<%= model["provider"] %>"><%= model["name"] %></span>
  <% end %>
  <%# Where it ran (after a turn) or where it will run (the chosen runtime).
      Only worth showing when the deployment offers a choice. %>
  <% rt_label = runtime["runtime"].presence || (conversation.configured_runtime if Agent::Runtime.selectable?) %>
  <% if rt_label.present? %>
    <span class="tag rt" title="<%= runtime["sandbox_id"] %>"><%= rt_label %></span>
  <% end %>
  <%# Only surface usage once it's meaningful (themis convention: ≥40%);
      a near-empty "ctx 2%" is just noise. Tint hot above 80%. %>
  <% percent = usage["percent"].to_f.clamp(0, 100) if window.positive? %>
  <% if percent && percent >= 40 %>
    <span class="ctx<%= " hot" if percent >= 80 %>" title="<%= format_tokens(usage["tokens"]) %> / <%= format_tokens(window) %> tokens">
      <span class="ctx-track"><span class="ctx-fill" style="width: <%= percent %>%"></span></span>
      ctx <%= percent.round %>%
    </span>
  <% end %>
</span>
