<%# Omit dom_id because matching browse rows remain hidden in the DOM. %>
<%= link_to conversation, class: "convo convo-search-row",
      data: { active_link_target: "link", turbo_frame: "main" } do %>
  <span class="convo-search-main">
    <span class="convo-search-title">
      <span class="tt"><%= conversation.display_title %></span>
      <% if conversation.workflow_run %>
        <span class="convo-pill"><%= t(".workflow") %></span>
      <% elsif conversation.routine %>
        <span class="convo-routine" title="<%= t('conversations.convo.routine_source', name: conversation.routine.name) %>"
              aria-label="<%= t('conversations.convo.routine_source', name: conversation.routine.name) %>">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="8" cy="8" r="6"/><path d="M8 4.5V8l2.5 1.5"/>
          </svg>
        </span>
      <% end %>
      <% if conversation.archived? %>
        <span class="convo-badge-archived"><%= t(".archived") %></span>
      <% end %>
    </span>
    <span class="convo-search-meta">
      <span><%= t(".updated_ago", time: time_ago_in_words(conversation.updated_at)) %></span>
      <% if conversation.project %>
        <span class="convo-search-sep" aria-hidden="true">·</span>
        <span class="convo-search-project"><%= conversation.project.name %></span>
      <% end %>
      <% if @sidebar_filter == "team" || conversation.user_id != current_user.id %>
        <span class="convo-search-sep" aria-hidden="true">·</span>
        <span class="convo-search-owner">
          <%= avatar_for conversation.user, size: 14, css: "convo-avatar convo-search-owner-avatar" %>
          <%= conversation.user.display_label %>
        </span>
      <% end %>
    </span>
  </span>
<% end %>
