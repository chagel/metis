<%# conversation: the chat being messaged, or nil to start a new one. %>
<% conversation = local_assigns[:conversation] %>
<% new_chat = conversation.nil? %>
<% post_url = new_chat ? conversations_path : conversation_messages_path(conversation) %>
<%# A new chat can instead launch a workflow: pick one and the composer
    posts to workflow_runs#create with the text as the run's input. %>
<% launchable = new_chat ? current_team.workflows.includes(:default_project).order(:name).to_a : [] %>
<% form_data = new_chat ? { turbo_frame: "_top" } : {} %>
<% if launchable.any?
     form_data.merge!(controller: "workflow-launch",
                      action: "skill-palette:launch->workflow-launch#selectFromPalette",
                      workflow_launch_runs_path_value: workflow_runs_path,
                      workflow_launch_chat_path_value: conversations_path)
   end %>
<% workflow_palette = launchable.map { |w|
     { id: w.id, name: w.name, steps: w.steps.size, gates: w.gate_count,
       description: w.description.to_s,
       intro: w.steps.first&.dig("prompt").to_s.truncate(120),
       default_project: w.default_project&.name,
       has_local_step: w.local_step? }
   } %>
<div id="composer" class="composer-wrap"
     data-controller="file-upload"
     data-action="dragover->file-upload#dragOver dragleave->file-upload#dragLeave drop->file-upload#drop paste->file-upload#paste">
  <div class="composer-inner">
    <% if local_assigns[:error].present? %>
      <div class="composer-error"><%= error %></div>
    <% end %>

    <%# New-chat submissions break out of the #main frame so the sidebar
        reloads and the freshly-created conversation appears in the list.
        Message submissions stay frame-bound — the controller responds
        with turbo_stream, which Turbo applies regardless of frame. %>
    <%= form_with url: post_url, method: :post, multipart: true, data: form_data do |form| %>
      <div data-file-upload-target="previews" class="previews"></div>

      <div class="composer-shell"
           data-controller="skill-palette"
           data-skill-palette-skills-value="<%= chat_skill_palette.to_json %>"
           data-skill-palette-workflows-value="<%= workflow_palette.to_json %>">
        <div hidden class="skill-palette" data-skill-palette-target="popup"></div>
        <div class="composer">
          <% if launchable.any? %>
            <input type="hidden" name="workflow_id" data-workflow-launch-target="field">
            <div class="composer-wf-chip" data-workflow-launch-target="chip" hidden>
              <span class="auto-chip">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4h5l1 1.5h5M2.5 4v8h11V5.5M2.5 8h11"/></svg>
                <span data-workflow-launch-target="chipName"></span>
                <button type="button" class="auto-chip-x" data-action="workflow-launch#clear" aria-label="Clear workflow">✕</button>
              </span>
              <% if current_team.projects.any? %>
                <%# Blank = the workflow's default project; the launch
                    controller retitles it ("Default — R&D" / "No project")
                    so a blank pick never reads like more than it is. %>
                <select name="project_id" class="wf-launch-project" aria-label="Project"
                        data-workflow-launch-target="project">
                  <option value="" data-workflow-launch-target="projectBlank">Default project</option>
                  <%= options_from_collection_for_select(current_team.projects.recent, :id, :name) %>
                </select>
              <% end %>
            </div>
          <% end %>
          <textarea name="content" rows="2"
                    data-controller="composer"
                    data-action="keydown->skill-palette#onKeydown keydown->composer#submitOnEnter input->skill-palette#onInput input->composer#autoResize"
                    placeholder="<%= new_chat ? (launchable.any? ? "Ask anything, or / for commands…" : "Ask anything to start a new chat…") : "Message the agent…" %>"></textarea>
        <div class="composer-bar">
          <label class="attach" title="Attach photos or files" aria-label="Attach photos or files">
            <input type="file" name="attachments[]" multiple
                   accept="<%= Message::ALLOWED_CONTENT_TYPES.join(",") %>"
                   class="hidden"
                   data-file-upload-target="input"
                   data-action="change->file-upload#filesPicked">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
            </svg>
          </label>

          <% if new_chat %>
            <% catalog_providers = Agent::Catalog.providers %>
            <span class="model-pick">
              <select name="model" aria-label="Model">
                <% selected_model = current_user.preferred_model.presence ||
                                    Agent::Catalog.default_model(catalog_providers) %>
                <%= grouped_options_for_select(
                      Agent::Catalog.grouped_model_options(catalog_providers), selected_model
                    ) %>
              </select>
              <svg class="caret" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                   stroke-width="1.7" aria-hidden="true">
                <path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <% unless current_team.personal? %>
              <label class="vis-chip" title="Toggle team visibility for this chat">
                <input type="hidden" name="visibility" value="personal">
                <input type="checkbox" name="visibility" value="team" class="vis-check">
                <span class="vis-opt">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
                       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M1.5 8S4 3.5 8 3.5 14.5 8 14.5 8 12 12.5 8 12.5 1.5 8 1.5 8z"/>
                    <circle cx="8" cy="8" r="2"/>
                  </svg>
                  Team
                </span>
              </label>
            <% end %>
          <% end %>

          <div class="composer-spacer"></div>
          <%= render "conversations/composer_actions", conversation: conversation %>
        </div>
        </div>
      </div>
    <% end %>

    <% unless new_chat %>
      <%# Hidden form the composer's Stop button submits (via form="cancel_turn"). %>
      <%= form_with url: cancel_conversation_path(conversation), method: :post, id: "cancel_turn" do %><% end %>
    <% end %>
  </div>
</div>
