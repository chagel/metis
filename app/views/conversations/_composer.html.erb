<%# conversation: the chat being messaged, or nil to start a new one. %>
<% conversation = local_assigns[:conversation] %>
<% new_chat = conversation.nil? %>
<% post_url = new_chat ? conversations_path : conversation_messages_path(conversation) %>
<div id="composer" class="composer-wrap"
     data-controller="file-upload"
     data-action="dragover->file-upload#dragOver dragleave->file-upload#dragLeave drop->file-upload#drop paste->file-upload#paste">
  <div class="composer-inner">
    <% if local_assigns[:error].present? %>
      <div class="composer-error"><%= error %></div>
    <% end %>

    <%# New-chat submissions break out of the #main frame so the sidebar
        reloads and the freshly-created conversation appears in the list.
        Message submissions stay frame-bound — the controller responds
        with turbo_stream, which Turbo applies regardless of frame. %>
    <%= form_with url: post_url, method: :post, multipart: true,
          data: (new_chat ? { turbo_frame: "_top" } : {}) do |form| %>
      <div data-file-upload-target="previews" class="previews"></div>

      <div class="composer-shell"
           data-controller="skill-palette"
           data-skill-palette-skills-value="<%= chat_skill_palette.to_json %>">
        <div hidden class="skill-palette" data-skill-palette-target="popup"></div>
        <div class="composer">
          <textarea name="content" rows="2"
                    data-controller="composer"
                    data-action="keydown->skill-palette#onKeydown keydown->composer#submitOnEnter input->skill-palette#onInput input->composer#autoResize"
                    placeholder="<%= new_chat ? "Ask anything to start a new chat…" : "Message the agent…" %>"></textarea>
        <div class="composer-bar">
          <label class="attach" title="Attach photos or files" aria-label="Attach photos or files">
            <input type="file" name="attachments[]" multiple
                   accept="<%= Message::ALLOWED_CONTENT_TYPES.join(",") %>"
                   class="hidden"
                   data-file-upload-target="input"
                   data-action="change->file-upload#filesPicked">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
            </svg>
          </label>

          <% if new_chat %>
            <% catalog_providers = Agent::Catalog.providers %>
            <span class="model-pick">
              <select name="model" aria-label="Model">
                <% selected_model = current_user.preferred_model.presence ||
                                    Agent::Catalog.default_model(catalog_providers) %>
                <%= grouped_options_for_select(
                      Agent::Catalog.grouped_model_options(catalog_providers), selected_model
                    ) %>
              </select>
              <svg class="caret" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                   stroke-width="1.7" aria-hidden="true">
                <path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>

            <%# Runtime picker — only when the deployment enables more than
                one runtime, else the chat silently uses the default. %>
            <% if Agent::Runtime.selectable? %>
              <span class="runtime-pick">
                <select name="runtime" aria-label="Runtime">
                  <% selected_runtime = current_user.preferred_runtime.presence ||
                                        Agent::Runtime.default.to_s %>
                  <%= options_for_select(Agent::Runtime.picker_options, selected_runtime) %>
                </select>
                <svg class="caret" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                     stroke-width="1.7" aria-hidden="true">
                  <path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            <% end %>
          <% end %>

          <div class="composer-spacer"></div>
          <%= render "conversations/composer_actions", conversation: conversation %>
        </div>
        </div>
      </div>
    <% end %>

    <% unless new_chat %>
      <%# Hidden form the composer's Stop button submits (via form="cancel_turn"). %>
      <%= form_with url: cancel_conversation_path(conversation), method: :post, id: "cancel_turn" do %><% end %>
    <% end %>
  </div>
</div>
