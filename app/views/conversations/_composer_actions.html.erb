<%# The composer's submit control: Send/Start while idle, Stop while a
    turn streams. Stop submits the hidden cancel_turn form. ChatJob
    swaps this back to Send when the turn ends. %>
<div id="composer_actions" class="composer-actions"
     data-composer-state="<%= conversation&.turn_in_progress? ? "streaming" : "idle" %>">
  <% if conversation&.turn_in_progress? %>
    <button type="submit" form="cancel_turn" class="send stop" title="<%= t('.stop') %>" aria-label="<%= t('.stop') %>">
      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <rect x="4" y="4" width="8" height="8" rx="1.5"/>
      </svg>
    </button>
  <% else %>
    <% label = conversation ? t('.send') : t('.start') %>
    <button type="submit" class="send" title="<%= label %>" aria-label="<%= label %>">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M8 13.5v-9M4 8.5l4-4 4 4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  <% end %>
</div>
