<%# The persistent shell sidebar: brand, primary nav, a section-contextual
    body (conversations on chat, a project list on projects/board), and the
    user menu. Rendered by the "chat" layout on every top-level page. The
    body collapses to the icon rail (.sidebar-rail) — the board opens
    collapsed by default (full-width grid); see nav_default_collapsed?. %>
<aside id="sidebar" class="sidebar" data-controller="conversation-filter">
  <div class="sidebar-full">
  <div class="ws">
    <div class="ws-crumb">
      <span class="ws-name">Metis</span>
      <%= render "shared/team_switcher" %>
    </div>
    <div style="flex:1"></div>
    <% if controller_name == "conversations" %>
      <%= link_to conversations_path, class: "ico-btn", title: "#{t('.new_chat')} ⌘N",
            data: { turbo_frame: "main", sidebar_target: "newChat" } do %>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M8 3v10M3 8h10" stroke-linecap="round"/>
        </svg>
      <% end %>
    <% elsif team_manager? %>
      <%= link_to new_project_path, class: "ico-btn", title: t('.new_project') do %>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M8 3v10M3 8h10" stroke-linecap="round"/>
        </svg>
      <% end %>
    <% end %>
  </div>

  <%# Section links do a full Turbo Drive visit so the server-rendered active
      state is right on load; the nav-tabs controller re-syncs it when a
      conversation opens as a #main frame swap (sidebar doesn't re-render
      then, so the tab would otherwise stay lit). %>
  <nav class="prnav" aria-label="<%= t('.primary_nav') %>" data-controller="nav-tabs">
    <%= link_to t('.chats'), conversations_path,
          class: "prnav-item#{' on' unless controller_name.in?(%w[board projects])}",
          data: { nav_tabs_target: "link" } %>
    <%= link_to t('.projects'), projects_path,
          class: "prnav-item#{' on' if controller_name == 'projects'}",
          data: { nav_tabs_target: "link" } %>
    <%= link_to board_path,
          class: "prnav-item#{' on' if controller_name == 'board'}",
          data: { nav_tabs_target: "link" } do %>
      <%= t('.board') %>
      <%= render "conversations/nav_badge", count: @needs_you&.size %>
    <% end %>
  </nav>

  <% if controller_name == "conversations" %>
    <div class="search">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5L14 14" stroke-linecap="round"/>
      </svg>
      <input type="search" placeholder="<%= t('.search') %>" aria-label="<%= t('.search') %>"
             data-conversation-filter-target="query"
             data-action="input->conversation-filter#filter">
    </div>

    <nav class="convos" aria-label="Conversations" data-turbo-prefetch="false"
         data-controller="infinite-scroll active-link">
      <%# The list (and its scope tabs) live in a turbo-frame so picking a
          tab swaps only the list — the open conversation in #main and the
          sidebar's scroll position stay put. Tabs are inside the frame, so
          the server re-renders their active state on each swap. %>
      <turbo-frame id="convos">
        <div class="convo-controls">
          <%# Preserve the active kind across a scope switch, but keep it out
              of the URL when it's the "all" default so tab links stay clean. %>
          <% tab_kind = @sidebar_kind unless @sidebar_kind == "all" %>
          <div class="convo-tabs" role="tablist">
            <%= link_to t('.tab_me'), conversations_path(filter: "active", kind: tab_kind), class: sidebar_tab_class("active") %>
            <%# A personal workspace is a team of one — nothing to share with. %>
            <% unless current_team.personal? %>
              <%= link_to conversations_path(filter: "team", kind: tab_kind), class: sidebar_tab_class("team") do %>
<%= t('.tab_team') %><%= render "conversations/team_tab_dot", active: false %>
              <% end %>
            <% end %>
            <%= link_to t('.tab_starred'), conversations_path(filter: "starred", kind: tab_kind), class: sidebar_tab_class("starred") %>
          </div>

          <%# Conversation-type filter — a second axis (chat/workflow/routine),
              kept in the frame so its active state re-renders on every swap. %>
          <div class="convo-kind<%= ' is-filtered' unless @sidebar_kind == 'all' %>" data-controller="dropdown">
            <button type="button" class="convo-kind-trigger" data-action="click->dropdown#toggle"
                    aria-haspopup="true" aria-expanded="false" title="<%= t('.filter_kind') %>">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 4h12M4 8h8M6 12h4"/>
              </svg>
            </button>
            <div class="convo-kind-panel" role="menu">
              <% ApplicationController::SIDEBAR_KINDS.each do |kind| %>
                <% active = @sidebar_kind == kind %>
                <%= link_to conversations_path(filter: @sidebar_filter, kind: kind),
                      class: "convo-kind-item#{' is-active' if active}",
                      role: "menuitemradio", "aria-checked": active do %>
                  <span class="convo-kind-item-name"><%= t(".kind_#{kind}") %></span>
                  <% if active %>
                    <svg class="convo-kind-item-check" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3.5 8.5l3 3 6-7"/>
                    </svg>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>

        <% if @needs_you.present? %>
          <div class="convos-pinned">
            <div class="grp-label"><%= t('.needs_you') %></div>
            <% @needs_you.each do |conversation| %>
              <%= render "conversations/convo", conversation: conversation %>
            <% end %>
          </div>
        <% end %>

        <div id="convos-list">
          <% if @conversations.any? %>
            <%= render "conversations/convo_items",
                  conversations: @conversations,
                  last_bucket: nil,
                  grouped: true %>
            <%= render "conversations/convo_sentinel",
                  pagy: @sidebar_pagy,
                  last_bucket: conversation_time_bucket(@conversations.last.updated_at),
                  filter: @sidebar_filter,
                  kind: @sidebar_kind %>
          <% else %>
            <div class="convos-empty"><%= sidebar_empty_message(@sidebar_filter) %></div>
          <% end %>
        </div>
        <div class="convos-empty" data-conversation-filter-target="empty" hidden><%= t('.no_matches') %></div>
      </turbo-frame>
    </nav>
  <% else %>
    <%= render "conversations/projects_nav" %>
  <% end %>

  <%= render "shared/user_menu" %>
  </div>

  <%# Icon rail shown when the sidebar is collapsed — the primary nav as
      vertical icons, so a collapsed section (e.g. the board) can still
      navigate. The logo/avatar expand the panel. %>
  <nav class="sidebar-rail" aria-label="<%= t('.rail') %>">
    <span class="sidebar-rail-logo" data-action="click->sidebar#expand" title="<%= t('.expand') %>">M</span>
    <%= link_to conversations_path, class: "rail-dest#{' on' if controller_name == 'conversations'}" do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M2 3.5h12v8H6.5l-3 2.5V11.5H2z" stroke-linejoin="round"/>
      </svg>
      <span class="rail-label"><%= t('.chats') %></span>
    <% end %>
    <%= link_to projects_path, class: "rail-dest#{' on' if controller_name == 'projects'}" do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M2 4.5h4l1 1.2h7V13H2z" stroke-linejoin="round"/>
      </svg>
      <span class="rail-label"><%= t('.projects') %></span>
    <% end %>
    <%# A plain dot, not the id'd nav_badge partial — that lives in the
        expanded prnav, and a second copy would duplicate its DOM id. %>
    <%= link_to board_path, class: "rail-dest#{' on' if controller_name == 'board'}" do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M2.5 2.5h3v11h-3zM6.5 2.5h3v7h-3zM10.5 2.5h3v11h-3z" stroke-linejoin="round"/>
      </svg>
      <% if @needs_you&.any? %><span class="rail-dot" aria-hidden="true"></span><% end %>
      <span class="rail-label"><%= t('.board') %></span>
    <% end %>
    <span style="flex:1"></span>
    <%= link_to "/settings", class: "rail-dest", data: { turbo_frame: "_top" } do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="8" cy="8" r="2.2"/>
        <path d="M13.5 8a5.5 5.5 0 00-.1-1.1l1.4-1-1.4-2.4-1.6.6a5.5 5.5 0 00-1.9-1.1L9.5 1h-3l-.4 1.9a5.5 5.5 0 00-1.9 1.1l-1.6-.6L1.2 5.9l1.4 1a5.5 5.5 0 000 2.2l-1.4 1 1.4 2.4 1.6-.6a5.5 5.5 0 001.9 1.1L6.5 15h3l.4-1.9a5.5 5.5 0 001.9-1.1l1.6.6 1.4-2.4-1.4-1c.07-.36.1-.73.1-1.1z"/>
      </svg>
      <span class="rail-label"><%= t('.settings') %></span>
    <% end %>
    <button type="button" class="sidebar-rail-avatar" title="<%= t('.expand') %>"
            aria-label="<%= t('.expand') %>" data-action="click->sidebar#expand">
      <%= avatar_for current_user, size: 32 %>
    </button>
  </nav>

  <%# The collapse handle lives on the seam between sidebar and main. %>
  <div class="sidebar-seam">
    <button type="button" class="sidebar-collapse"
            data-action="click->sidebar#toggleCollapse"
            aria-label="<%= t('.collapse') %>" title="<%= t('.collapse') %> ⌘B">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M10 3L5 8l5 5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</aside>
