<%# Page 1 of a title search, answering the convos-search frame
    navigation (layout: false — the sidebar shell is already on the
    page). A short query renders the empty frame; the client keeps the
    browse list for that state. %>
<turbo-frame id="convos-search">
  <% if @query.length >= 2 %>
    <% if @search_results.any? %>
      <h2 class="convos-search-summary"><%= t(".results_for", query: @query) %></h2>
      <div id="convos-search-list">
        <%= render partial: "conversations/search_result",
              collection: @search_results, as: :conversation %>
      </div>
      <%= render "conversations/search_sentinel",
            pagy: @search_pagy, query: @query,
            filter: @sidebar_filter, kind: @sidebar_kind %>
    <% else %>
      <div class="convos-empty"><%= t(".empty", query: @query) %></div>
    <% end %>
  <% end %>
</turbo-frame>
