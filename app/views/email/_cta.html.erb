<%# Shared email call-to-action: the branded button + a paste-able
    fallback link. Locals: url, label. Used by every transactional email
    so the button design stays identical across them. %>
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 24px;">
  <tr>
    <td style="border-radius:8px; background-color:#2c2d27; background-image:linear-gradient(145deg,#4b4c42,#2c2d27);">
      <a href="<%= url %>" style="display:inline-block; padding:12px 26px; font-size:15px; font-weight:600; line-height:20px; color:#ffffff; text-decoration:none;">
        <%= label %>
      </a>
    </td>
  </tr>
</table>

<p style="margin:0 0 24px; font-size:13px; line-height:20px; color:#78716c;">
  <%= t(".fallback") %><br>
  <a href="<%= url %>" style="color:#44403c; word-break:break-all;"><%= url %></a>
</p>
