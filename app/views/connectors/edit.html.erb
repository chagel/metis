<% content_for :title, @app&.name || @connector.name %>

<main class="pane">
  <header class="pane-head">
    <%= link_to connectors_path, class: "ico-btn", title: t('.back') do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M10 3L5 8l5 5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    <% end %>
    <h1 class="pane-title"><%= @app&.name || @connector.name %></h1>
    <div style="flex:1"></div>
    <%= button_to t('.disconnect'), connector_path(@connector), method: :delete, class: "btn btn-danger",
          form: { data: { turbo_confirm: t('.disconnect_confirm', name: @connector.name) } } %>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <% if @app %>
        <p class="pane-lead"><%= @app.description %></p>

        <% if @app.oauth? %>
          <% oauth_path = connector_authorize_path_for(@app) %>
          <% if oauth_path.nil? %>
            <section class="conn-status">
              <div class="conn-status-main">
                <div class="conn-status-title"><%= t('.oauth_unconfigured_title', name: @app.name) %></div>
                <div class="conn-status-sub">
                  <%= t('.oauth_unconfigured_sub', name: @app.name) %>
                </div>
              </div>
            </section>
          <% elsif @credential&.oauth_ready? %>
            <section class="conn-status ok">
              <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                   stroke-width="2" aria-hidden="true">
                <path d="M3 8.5l3.5 3.5L13 4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <div class="conn-status-main">
                <div class="conn-status-title">
                <% if @credential.external_login.present? %>
                  <%= t('.connected_as', login: @credential.external_login, name: @app.name) %>
                <% else %>
                  <%= t('.connected_account', name: @app.name) %>
                <% end %>
              </div>
                <div class="conn-status-sub"><%= t('.reauthorize_hint') %></div>
              </div>
              <%= button_to t('.reauthorize'), oauth_path,
                    data: { turbo: false }, class: "btn btn-ghost" %>
            </section>
          <% else %>
            <section class="conn-status">
              <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                   stroke-width="1.6" aria-hidden="true">
                <circle cx="8" cy="8" r="6"/>
              </svg>
              <div class="conn-status-main">
                <div class="conn-status-title"><%= t('.not_connected') %></div>
                <div class="conn-status-sub"><%= t('.each_member', name: @app.name) %></div>
              </div>
              <%= button_to t('.authorize_on', name: @app.name), oauth_path,
                    data: { turbo: false }, class: "btn btn-primary" %>
            </section>
          <% end %>
        <% end %>

        <% if @app.oauth_provider == "github" && GithubApp::Config.app_auth_configured? %>
          <section class="conn-bot">
            <%= form_with model: @connector, class: "conn-form" do |f| %>
              <label class="conn-bot-toggle">
                <%# hidden "0" companion so unchecking + Save actually disables the
                    bot — check_box_tag alone omits the param when unchecked. %>
                <%= hidden_field_tag "connector[bot_enabled]", "0" %>
                <%= check_box_tag "connector[bot_enabled]", "1", @connector.bot_enabled? %>
                <span class="conn-bot-main">
                  <span class="conn-bot-title"><%= t('.bot_title') %></span>
                  <span class="conn-bot-sub">
                    <%= t('.bot_sub_pre') %>
                    <code><%= GithubApp::Config.app_slug || "metis" %>[bot]</code>. <%= t('.bot_sub_post') %>
                  </span>
                </span>
              </label>
              <% if @installations.many? %>
                <div class="field">
                  <%= label_tag "connector[bot_installation_id]", t('.act_through') %>
                  <%= select_tag "connector[bot_installation_id]",
                        options_for_select(
                          @installations.map { |i| [ "#{i["login"]} (#{i["type"].to_s.downcase})", i["id"] ] },
                          @connector.bot_installation_id
                        ),
                        include_blank: t('.choose_installation') %>
                  <p class="field-hint">
                    <%= t('.installation_hint') %>
                  </p>
                </div>
              <% end %>
              <div class="form-actions">
                <%= f.submit t('common.save'), class: "btn btn-primary" %>
              </div>
            <% end %>
          </section>
        <% end %>

        <% if @connector.catalog_key == "linear" && @linear_api_configured %>
          <section class="conn-bot">
            <div class="conn-bot-main">
              <span class="conn-bot-title"><%= t('.linear_api_title') %></span>
              <span class="conn-bot-sub"><%= t('.linear_api_sub') %></span>
            </div>
            <% if @linear_api_connected %>
              <div class="conn-status ok">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                     stroke-width="2" aria-hidden="true">
                  <path d="M3 8.5l3.5 3.5L13 4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <div class="conn-status-main">
                  <div class="conn-status-title"><%= t('.linear_api_connected') %></div>
                </div>
                <%= button_to t('.linear_api_reauthorize'), connector_linear_authorize_path,
                      data: { turbo: false }, class: "btn btn-ghost" %>
              </div>
            <% else %>
              <%= button_to t('.linear_api_authorize'), connector_linear_authorize_path,
                    data: { turbo: false }, class: "btn btn-primary" %>
            <% end %>
          </section>
        <% end %>

        <% if @app.token_auth? && @app.credential %>
          <%= form_with model: @connector, class: "conn-form" do |f| %>
            <div class="field">
              <%= label_tag :credential, @app.credential["label"] %>
              <%= password_field_tag :credential, nil, autocomplete: "off",
                    placeholder: @credential ? t('.credential_placeholder') : nil %>
              <% if @app.credential["hint"] %>
                <p class="field-hint"><%= @app.credential["hint"] %></p>
              <% end %>
            </div>
            <div class="form-actions">
              <%= f.submit t('common.save'), class: "btn btn-primary" %>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <%= render "form", connector: @connector %>
      <% end %>
    </div>
  </div>
</main>
