<% content_for :title, @app&.name || @connector.name %>

<main class="pane">
  <header class="pane-head">
    <%= link_to connectors_path, class: "ico-btn", title: "Back to connectors" do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M10 3L5 8l5 5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    <% end %>
    <h1 class="pane-title"><%= @app&.name || @connector.name %></h1>
    <div style="flex:1"></div>
    <%= button_to "Disconnect", connector_path(@connector), method: :delete, class: "btn btn-danger",
          form: { data: { turbo_confirm: "Disconnect #{@connector.name}?" } } %>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <% if @app %>
        <p class="pane-lead"><%= @app.description %></p>

        <% if @app.oauth? %>
          <% oauth_path = connector_authorize_path_for(@app) %>
          <% if oauth_path.nil? %>
            <section class="conn-status">
              <div class="conn-status-main">
                <div class="conn-status-title"><%= @app.name %> OAuth is not configured</div>
                <div class="conn-status-sub">
                  This deployment hasn't set OAuth credentials for <%= @app.name %>.
                  Ask your admin to configure it before connecting.
                </div>
              </div>
            </section>
          <% elsif @credential&.oauth_ready? %>
            <section class="conn-status ok">
              <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                   stroke-width="2" aria-hidden="true">
                <path d="M3 8.5l3.5 3.5L13 4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <div class="conn-status-main">
                <div class="conn-status-title">
                <% if @credential.external_login.present? %>
                  Connected as @<%= @credential.external_login %> on <%= @app.name %>
                <% else %>
                  Your <%= @app.name %> account is connected
                <% end %>
              </div>
                <div class="conn-status-sub">Re-authorize if access stops working.</div>
              </div>
              <%= button_to "Re-authorize", oauth_path,
                    data: { turbo: false }, class: "btn btn-ghost" %>
            </section>
          <% else %>
            <section class="conn-status">
              <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                   stroke-width="1.6" aria-hidden="true">
                <circle cx="8" cy="8" r="6"/>
              </svg>
              <div class="conn-status-main">
                <div class="conn-status-title">Not connected yet</div>
                <div class="conn-status-sub">Each member connects their own <%= @app.name %> account.</div>
              </div>
              <%= button_to "Authorize on #{@app.name}", oauth_path,
                    data: { turbo: false }, class: "btn btn-primary" %>
            </section>
          <% end %>
        <% end %>

        <% if @app.oauth_provider == "github" && GithubApp::Config.app_auth_configured? %>
          <section class="conn-bot">
            <%= form_with model: @connector, class: "conn-form" do |f| %>
              <label class="conn-bot-toggle">
                <%# hidden "0" companion so unchecking + Save actually disables the
                    bot — check_box_tag alone omits the param when unchecked. %>
                <%= hidden_field_tag "connector[bot_enabled]", "0" %>
                <%= check_box_tag "connector[bot_enabled]", "1", @connector.bot_enabled? %>
                <span class="conn-bot-main">
                  <span class="conn-bot-title">Let the agent act as the GitHub bot</span>
                  <span class="conn-bot-sub">
                    Lets the agent post PR reviews as
                    <code><%= GithubApp::Config.app_slug || "metis" %>[bot]</code>. Every
                    member gets this, reaching every repo the App is installed on — scope
                    it on GitHub.
                  </span>
                </span>
              </label>
              <div class="form-actions">
                <%= f.submit "Save", class: "btn btn-primary" %>
              </div>
            <% end %>
          </section>
        <% end %>

        <% if @app.token_auth? && @app.credential %>
          <%= form_with model: @connector, class: "conn-form" do |f| %>
            <div class="field">
              <%= label_tag :credential, @app.credential["label"] %>
              <%= password_field_tag :credential, nil, autocomplete: "off",
                    placeholder: @credential ? "Set — leave blank to keep the current one" : nil %>
              <% if @app.credential["hint"] %>
                <p class="field-hint"><%= @app.credential["hint"] %></p>
              <% end %>
            </div>
            <div class="form-actions">
              <%= f.submit "Save", class: "btn btn-primary" %>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <%= render "form", connector: @connector %>
      <% end %>
    </div>
  </div>
</main>
