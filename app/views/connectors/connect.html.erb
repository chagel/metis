<% content_for :title, "Connect #{@app.name}" %>

<main class="pane">
  <header class="pane-head">
    <%= link_to connectors_path, class: "ico-btn", title: "Back to connectors" do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M10 3L5 8l5 5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    <% end %>
    <h1 class="pane-title">Connect <%= @app.name %></h1>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <p class="pane-lead"><%= @app.description %></p>

      <% if @app.token_auth? %>
        <%= form_with url: connectors_path, method: :post, class: "conn-form" do %>
          <%= hidden_field_tag :catalog_key, @app.key %>

          <% @app.inputs.each do |input| %>
            <div class="field">
              <%= label_tag "inputs_#{input['key']}", input["label"] %>
              <%= text_field_tag "inputs[#{input['key']}]", nil,
                    id: "inputs_#{input['key']}", autocomplete: "off" %>
            </div>
          <% end %>

          <% if @app.credential %>
            <div class="field">
              <%= label_tag :credential, @app.credential["label"] %>
              <%= password_field_tag :credential, nil, autocomplete: "off" %>
              <% if @app.credential["hint"] %>
                <p class="field-hint"><%= @app.credential["hint"] %></p>
              <% end %>
            </div>
          <% end %>

          <div class="form-actions">
            <%= submit_tag "Connect #{@app.name}", class: "btn btn-primary" %>
            <%= link_to "Cancel", connectors_path, class: "btn btn-ghost" %>
          </div>
        <% end %>
      <% elsif @app.mcp_oauth? %>
        <%# Per-instance OAuth (DCR): collect the server URL, then POST to
            the connect flow which discovers + registers against it. %>
        <%= form_with url: connector_oauth_start_path(@app.key), method: :post,
              class: "conn-form", data: { turbo: false } do %>
          <% @app.inputs.each do |input| %>
            <div class="field">
              <%= label_tag "inputs_#{input['key']}", input["label"] %>
              <%= url_field_tag "inputs[#{input['key']}]", nil,
                    id: "inputs_#{input['key']}", autocomplete: "off",
                    placeholder: input["placeholder"] %>
            </div>
          <% end %>

          <div class="form-actions">
            <%= submit_tag "Connect #{@app.name}", class: "btn btn-primary" %>
            <%= link_to "Cancel", connectors_path, class: "btn btn-ghost" %>
          </div>
        <% end %>
      <% else %>
        <div class="pane-empty">
          <p><%= @app.name %> is not connectable yet.</p>
        </div>
      <% end %>
    </div>
  </div>
</main>
