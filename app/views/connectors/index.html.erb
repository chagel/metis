<% content_for :title, "Connectors" %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title">Connectors</h1>
    <div style="flex:1"></div>
    <% if team_manager? %>
      <%= link_to "Add custom MCP server", new_connector_path, class: "btn btn-ghost" %>
    <% end %>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <p class="pane-lead">Connect the agent to third-party apps over MCP.</p>

      <% @apps.group_by(&:category).each do |category, apps| %>
        <div class="cat-label"><%= category %></div>
        <div class="app-grid">
          <% apps.each do |app| %>
            <% connector = @connected[app.key] %>
            <%# "Connected" means the same thing here as on the manage page
                AND in McpConfig: an OAuth-shaped connector needs both the
                Connector row AND a grant that covers its catalog scopes,
                otherwise the tile would advertise a connector McpConfig
                drops every turn. %>
            <% wired = connector && (app.oauth? ? connector.credential_for(current_user)&.oauth_ready? : true) %>
            <%# "Reconnect" only when *I* connected before (my own credential
                exists but lapsed); a teammate's connector or a login-only
                grant means I've never connected this → "Connect". %>
            <% mine = connector&.connector_credentials&.exists?(user: current_user) %>
            <div class="app-tile">
              <div class="app-name"><%= app.name %></div>
              <div class="app-desc"><%= app.description %></div>
              <div class="app-foot">
                <% if wired %>
                  <span class="app-state connected">Connected</span>
                  <div style="flex:1"></div>
                  <% if team_manager? %>
                    <%= link_to "Manage", edit_connector_path(connector), class: "btn btn-ghost" %>
                  <% end %>
                <% elsif app.oauth? && (oauth_path = connector_authorize_path_for(app)) %>
                  <div style="flex:1"></div>
                  <%= button_to(mine ? "Reconnect" : "Connect", oauth_path,
                        data: { turbo: false }, class: "btn btn-primary") %>
                <% elsif app.oauth? %>
                  <span class="app-state">OAuth — coming soon</span>
                <% elsif team_manager? %>
                  <div style="flex:1"></div>
                  <%= link_to "Connect", new_connector_path(app: app.key), class: "btn btn-primary" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @custom.any? %>
        <div class="cat-label">Custom</div>
        <div class="conn-list">
          <% @custom.each do |connector| %>
            <%# Managers edit a custom connector; members see it read-only. %>
            <%= content_tag(team_manager? ? :a : :div, class: "conn-row",
                  href: (team_manager? ? edit_connector_path(connector) : nil)) do %>
              <div class="conn-main">
                <div class="conn-name"><%= connector.name %></div>
                <div class="conn-sub">
                  <%= connector.definition["command"].presence || connector.definition["url"] %>
                </div>
              </div>
              <span class="tag rt"><%= connector.transport %></span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</main>
