<% content_for :title, t('.title') %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title"><%= t('.heading') %></h1>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <p class="pane-lead"><%= t('.lead') %></p>

      <% @apps.group_by(&:category).each do |category, apps| %>
        <div class="cat-label"><%= category %></div>
        <div class="app-grid">
          <% apps.each do |app| %>
            <% connector = @connected[app.key] %>
            <%# "Connected" means the same thing here as on the manage page
                AND in McpConfig: an OAuth-shaped connector needs both the
                Connector row AND a grant that covers its catalog scopes,
                otherwise the tile would advertise a connector McpConfig
                drops every turn. %>
            <% member_cred = connector&.credential_for(current_user) %>
            <% wired =
                 if connector.nil? then false
                 elsif app.oauth? then member_cred&.oauth_ready?
                 elsif app.mcp_oauth? then member_cred&.mcp_oauth_access_token.present?
                 else true
                 end %>
            <%# "Reconnect" only when *I* connected before (my own credential
                exists but lapsed); a teammate's connector or a login-only
                grant means I've never connected this → "Connect". %>
            <% mine = connector&.connector_credentials&.exists?(user: current_user) %>
            <div class="app-tile">
              <div class="app-head">
                <div class="app-name"><%= app.name %></div>
                <% if connector_needs_setup?(app) %>
                  <span class="app-dot"
                        title="<%= t('.setup_required_title') %>"
                        aria-label="<%= t('.setup_required') %>"></span>
                <% end %>
              </div>
              <div class="app-desc"><%= app.description %></div>
              <div class="app-foot">
                <% if wired %>
                  <span class="app-state connected"><%= t('.connected') %></span>
                  <div style="flex:1"></div>
                  <% if app.oauth_provider == "x" && mine %>
                    <%= button_to t('.disconnect'), connector_x_disconnect_path, method: :delete, class: "btn btn-ghost",
                          form: { data: { turbo_confirm: t('.x_disconnect_confirm') } } %>
                  <% end %>
                  <% if team_manager? %>
                    <%= link_to t('.manage'), edit_connector_path(connector), class: "btn btn-ghost" %>
                  <% end %>
                <% elsif app.oauth? && (oauth_path = connector_authorize_path_for(app)) %>
                  <div style="flex:1"></div>
                  <%= button_to(mine ? t('.reconnect') : t('.connect'), oauth_path,
                        data: { turbo: false }, class: "btn btn-primary") %>
                <% elsif app.oauth_provider == "x" %>
                  <span class="app-state"><%= t('.x_unavailable') %></span>
                  <div style="flex:1"></div>
                  <button class="btn btn-primary" disabled><%= t('.connect') %></button>
                <% elsif app.oauth? %>
                  <span class="app-state"><%= t('.oauth_coming_soon') %></span>
                <% elsif app.mcp_oauth? && app.inputs.any? %>
                  <%# Per-instance: collect the server URL on a form first. %>
                  <div style="flex:1"></div>
                  <%= link_to(mine ? t('.reconnect') : t('.connect'), new_connector_path(app: app.key),
                        class: "btn btn-primary") %>
                <% elsif app.mcp_oauth? %>
                  <div style="flex:1"></div>
                  <%= button_to(mine ? t('.reconnect') : t('.connect'), connector_oauth_start_path(app.key),
                        data: { turbo: false }, class: "btn btn-primary") %>
                <% elsif team_manager? %>
                  <div style="flex:1"></div>
                  <%= link_to t('.connect'), new_connector_path(app: app.key), class: "btn btn-primary" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</main>
