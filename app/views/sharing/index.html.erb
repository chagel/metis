<% content_for :title, t(".title") %>

<main class="sharing">
  <header class="sharing-head">
    <h1><%= t(".title") %></h1>
  </header>

  <% if @sharing.any? %>
    <% if @sharing.conversations.any? %>
      <section class="sharing-section">
        <h2 class="sharing-section-title"><%= t(".conversations") %></h2>
        <% @sharing.conversations.each do |conversation| %>
          <%= render "sharing/row",
                kind: :conversation,
                title: conversation.display_title,
                url: shared_conversation_url(token: conversation.share_token),
                shared_at: conversation.shared_at || conversation.updated_at,
                revoke_path: (conversation.user_id == current_user.id ? share_conversation_path(conversation) : nil) %>
        <% end %>
      </section>
    <% end %>

    <% if @sharing.artifact_shares.any? %>
      <section class="sharing-section">
        <h2 class="sharing-section-title"><%= t(".artifacts") %></h2>
        <% @sharing.artifact_shares.each do |share| %>
          <%= render "sharing/row",
                kind: :artifact,
                title: share.blob.filename,
                url: shared_artifact_url(token: share.token),
                shared_at: share.created_at,
                revoke_path: (share.created_by_id == current_user.id ? artifact_share_path(share) : nil) %>
        <% end %>
      </section>
    <% end %>
  <% else %>
    <div class="sharing-empty">
      <p class="sharing-empty-title"><%= t(".empty_title") %></p>
      <p class="sharing-empty-desc"><%= t(".empty_desc") %></p>
    </div>
  <% end %>
</main>
