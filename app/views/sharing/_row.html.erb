<%# One shared item. revoke_path nil => no Stop-sharing button (you can
    only revoke what you shared). %>
<div class="sharing-row" data-controller="share" data-share-copied-value="<%= t('sharing.index.copied') %>">
  <span class="sharing-ico">
    <% if kind == :conversation %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z"/>
      </svg>
    <% else %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
      </svg>
    <% end %>
  </span>
  <div class="sharing-meta">
    <span class="sharing-title"><%= title %></span>
    <input type="text" class="sharing-url" readonly
           value="<%= url %>"
           data-share-target="url"
           data-action="focus->share#selectAll">
  </div>
  <span class="sharing-time"><%= t("sharing.index.shared_ago", time: time_ago_in_words(shared_at)) %></span>
  <button type="button" class="sharing-copy"
          data-action="click->share#copy"
          data-share-target="copyButton"><%= t("sharing.index.copy") %></button>
  <% if revoke_path %>
    <%# Full-page submit on purpose: the toggle answers over Turbo Stream
        targeting an inline panel that doesn't exist on this page. %>
    <%= button_to t("sharing.index.stop_sharing"), revoke_path,
          method: :delete, class: "sharing-stop", form: { data: { turbo: false } } %>
  <% end %>
</div>
