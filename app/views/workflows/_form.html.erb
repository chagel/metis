<%= form_with model: workflow, url: workflow.persisted? ? workflow_path(workflow) : workflows_path, class: "conn-form" do |f| %>
  <% if workflow.errors.any? %>
    <div class="flash error"><%= workflow.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, placeholder: t(".name_placeholder"), autocomplete: "off" %>
  </div>

  <div class="field">
    <%= f.label :description %>
    <%= f.text_field :description, placeholder: t(".description_placeholder") %>
  </div>

  <div class="field">
    <%= f.label :default_project_id, t(".default_project_label") %>
    <%= f.collection_select :default_project_id, current_team.projects.recent, :id, :name,
          { include_blank: t(".include_blank") }, class: "team-input" %>
    <p class="field-hint"><%= t(".default_project_hint") %></p>
  </div>

  <div class="field">
    <%= f.label :trigger_source, t(".trigger_label") %>
    <%= f.select :trigger_source, Workflow.trigger_sources.keys.map { |k| [ k.humanize, k ] }, {}, class: "team-input" %>
    <p class="field-hint"><%= t(".trigger_hint") %></p>
  </div>

  <div class="field">
    <%= f.label :steps, t(".steps_label") %>
    <p class="field-hint"><%= t(".steps_hint_html", bridge_token_link: link_to(t(".bridge_token"), developer_path)) %></p>
    <div class="wf-steps" data-controller="workflow-editor">
      <div class="wf-steps-list" data-workflow-editor-target="list"
           data-action="dragover->workflow-editor#dragOver">
        <% row_index = -1 %>
        <% workflow.steps.each do |step| %>
          <%= render "step_row", index: (row_index += 1), step: step %>
          <% if step["gate"] == "approval" %>
            <%= render "break_row", index: (row_index += 1) %>
          <% end %>
        <% end %>
      </div>
      <template data-workflow-editor-target="template">
        <%= render "step_row", index: "NEW_RECORD", step: {} %>
      </template>
      <template data-workflow-editor-target="breakTemplate">
        <%= render "break_row", index: "NEW_RECORD" %>
      </template>
      <div class="wf-step-adds">
        <button type="button" class="wf-step-add" data-action="workflow-editor#add">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3.5v9M3.5 8h9"/></svg>
          <%= t(".add_prompt_step") %>
        </button>
        <button type="button" class="wf-step-add wf-step-add--break" data-action="workflow-editor#add"
                data-workflow-editor-kind-param="break">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 3.5v9M10.5 3.5v9"/></svg>
          <%= t(".add_break") %>
        </button>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit(workflow.persisted? ? t("common.save") : t(".create_workflow"), class: "btn btn-primary") %>
  </div>
<% end %>
