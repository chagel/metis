<%= form_with model: workflow, url: workflow.persisted? ? workflow_path(workflow) : workflows_path, class: "conn-form" do |f| %>
  <% if workflow.errors.any? %>
    <div class="flash error"><%= workflow.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, placeholder: "Triage & fix Sentry error", autocomplete: "off" %>
  </div>

  <div class="field">
    <%= f.label :description %>
    <%= f.text_field :description, placeholder: "Investigate an incoming error, draft a fix, gate, ship." %>
  </div>

  <div class="field">
    <%= f.label :default_project_id, "Default project" %>
    <%= f.collection_select :default_project_id, current_team.projects.recent, :id, :name,
          { include_blank: "None" }, class: "team-input" %>
    <p class="field-hint">Suggested context at launch — its standards reach the agent via AGENTS.md. Overridable per run.</p>
  </div>

  <div class="field">
    <%= f.label :trigger_source, "Trigger" %>
    <%= f.select :trigger_source, Workflow.trigger_sources.keys.map { |k| [ k.humanize, k ] }, {}, class: "team-input" %>
    <p class="field-hint">Manual runs from the catalog. Webhook and schedule triggers activate in a later release.</p>
  </div>

  <div class="field">
    <%= f.label :steps, "Steps" %>
    <p class="field-hint">Each step runs its prompt as one agent turn — the name is just a label, the prompt is the instruction. Set a step to <strong>Gate</strong> to pause for your review after it runs.</p>
    <div class="wf-steps" data-controller="workflow-editor">
      <div class="wf-steps-list" data-workflow-editor-target="list"
           data-action="dragover->workflow-editor#dragOver">
        <% workflow.steps.each_with_index do |step, i| %>
          <%= render "step_row", index: i, step: step %>
        <% end %>
      </div>
      <template data-workflow-editor-target="template">
        <%= render "step_row", index: "NEW_RECORD", step: {} %>
      </template>
      <button type="button" class="wf-step-add" data-action="workflow-editor#add">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3.5v9M3.5 8h9"/></svg>
        Add step
      </button>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit(workflow.persisted? ? "Save" : "Create workflow", class: "btn btn-primary") %>
  </div>
<% end %>
