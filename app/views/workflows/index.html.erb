<% content_for :title, "Workflows" %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title">Workflows</h1>
    <div style="flex:1"></div>
    <% if team_manager? %>
      <%= link_to "New", new_workflow_path, class: "btn btn-ghost" %>
    <% end %>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <% if @workflows.any? %>
        <div class="conn-list"><%= render @workflows %></div>
      <% else %>
        <div class="pane-empty">
          <p>No workflows yet. A workflow is a saved recipe the agent runs on its own, pausing at gates for your approval.</p>
          <% if team_manager? %>
            <%= link_to "Create your first workflow", new_workflow_path, class: "btn btn-primary" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</main>
