<% content_for :title, t(".title") %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title"><%= t(".title") %></h1>
    <div style="flex:1"></div>
    <% if team_manager? %>
      <%= link_to t(".new"), new_workflow_path, class: "btn btn-ghost" %>
    <% end %>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <% if @workflows.any? %>
        <div class="conn-list"><%= render @workflows %></div>
      <% else %>
        <div class="pane-empty">
          <p><%= t(".empty") %></p>
          <% if team_manager? %>
            <%= link_to t(".create_first"), new_workflow_path, class: "btn btn-primary" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</main>
