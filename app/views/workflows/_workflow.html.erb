<div class="conn-row">
  <div class="conn-main">
    <div class="conn-name"><%= workflow.name %></div>
    <div class="conn-sub">
      <%= pluralize(workflow.steps.size, "step") %> ·
      <%= pluralize(workflow.gate_count, "break") %> ·
      <%= workflow.trigger_source %>
      <%= "· #{workflow.default_project.name}" if workflow.default_project %>
    </div>
  </div>
  <% if team_manager? %>
    <div class="conn-actions">
      <%= link_to "Edit", edit_workflow_path(workflow), class: "btn btn-ghost btn-sm" %>
    </div>
  <% end %>
</div>
