<div class="wf-step-row" data-workflow-editor-target="row" draggable="true"
     data-action="dragstart->workflow-editor#dragStart dragend->workflow-editor#dragEnd">
  <div class="wf-step-grip" aria-hidden="true">⋮⋮</div>
  <div class="wf-step-fields">
    <% gated = step["gate"] == "approval" %>
    <div class="wf-step-head">
      <input type="text" name="workflow[steps][<%= index %>][name]"
             value="<%= step["name"] %>" placeholder="Step name" class="wf-step-name">
      <div class="wf-step-gate" role="radiogroup" aria-label="After this step">
        <label class="wf-gate-opt">
          <input type="radio" name="workflow[steps][<%= index %>][gate]" value="auto" <%= "checked" unless gated %>>
          <span>Auto</span>
        </label>
        <label class="wf-gate-opt wf-gate-opt--gate">
          <input type="radio" name="workflow[steps][<%= index %>][gate]" value="approval" <%= "checked" if gated %>>
          <span title="Pause for approval after this step">Gate</span>
        </label>
      </div>
      <button type="button" class="wf-step-del" data-action="workflow-editor#remove"
              title="Remove step" aria-label="Remove step">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 4.5h10M6.5 4.5V3.5a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v1m1.5 0v8a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-8"/>
        </svg>
      </button>
    </div>
    <textarea name="workflow[steps][<%= index %>][prompt]" rows="2"
              placeholder="What should the agent do in this step?"
              class="wf-step-prompt"><%= step["prompt"] %></textarea>
  </div>
</div>
