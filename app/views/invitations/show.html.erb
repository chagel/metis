<% content_for :title, t('.title') %>

<% if @invitation.expired? %>
  <h2><%= t('.expired_heading') %></h2>
  <p class="auth-sub">
    <%= t('.expired_body', name: @invitation.invited_by.display_label) %>
  </p>
  <% unless user_signed_in? %>
    <div class="auth-foot"><%= link_to t('.go_to_metis'), new_user_session_path, class: "auth-link" %></div>
  <% end %>

<% elsif @invitation.accepted? %>
  <h2><%= t('.used_heading') %></h2>
  <p class="auth-sub"><%= t('.used_body') %></p>
  <% unless user_signed_in? %>
    <div class="auth-foot"><%= link_to t('.sign_in_to_metis'), new_user_session_path, class: "auth-link" %></div>
  <% end %>

<% elsif user_signed_in? && @invitation.for?(current_user) %>
  <h2><%= t('.join_heading', team: @invitation.team.name) %></h2>
  <p class="auth-sub">
    <strong><%= @invitation.invited_by.display_label %></strong> <%= t('.invited_to_join') %>
    <strong><%= @invitation.team.name %></strong> <%= t('.as_role', role: @invitation.role) %>
  </p>
  <%= button_to t('.join_submit', team: @invitation.team.name), accept_invitation_path(@invitation.token),
        class: "auth-submit" %>

<% elsif user_signed_in? %>
  <h2><%= t('.wrong_account_heading') %></h2>
  <p class="auth-sub">
    <%= t('.wrong_account_html',
          invited_email: tag.strong(@invitation.email),
          current_email: tag.strong(current_user.email),
          email: @invitation.email) %>
  </p>
  <%= button_to t('.sign_out'), destroy_user_session_path, method: :delete, class: "auth-submit" %>

<% else %>
  <h2><%= t('.invited_heading') %></h2>
  <p class="auth-sub">
    <strong><%= @invitation.invited_by.display_label %></strong> <%= t('.invited_to_join') %>
    <strong><%= @invitation.team.name %></strong> <%= t('.on_metis_as_role', role: @invitation.role) %>
  </p>
  <%= link_to t('.create_account'), new_user_registration_path(email: @invitation.email),
        class: "auth-submit auth-submit-link" %>
  <div class="auth-foot">
    <%= t('.have_account') %>
    <%= link_to t('.sign_in'), new_user_session_path(email: @invitation.email), class: "auth-link" %>
  </div>

  <div class="invite-about">
    <p class="invite-pitch">
      <strong>Metis</strong> <%= t('.pitch') %>
    </p>
    <ul class="invite-features">
      <% [
           t('.feature_chat'),
           t('.feature_share'),
           t('.feature_models')
         ].each do |point| %>
        <li class="invite-feature">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
          <span><%= point %></span>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
