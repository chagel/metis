<%= form_with model: project, url: project.persisted? ? project_path(project) : projects_path, class: "conn-form" do |f| %>
  <% if project.errors.any? %>
    <div class="flash error"><%= project.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, placeholder: "Metis", autocomplete: "off" %>
    <p class="field-hint">A short name you recognize — "Metis", "Q4 planning", "Mom's birthday".</p>
  </div>

  <div class="field">
    <%= f.label :about, "About this project" %>
    <%= f.text_area :about, rows: 5,
          placeholder: "What's this project about? The agent reads this on every turn in this project.\n\nName the resources it maps to — e.g. \"GitHub repo chagel/metis, Linear project Metis\"." %>
    <p class="field-hint">Freeform notes — conventions, constraints, who's involved, which repo or board it maps to. Shows up in the agent's context.</p>
  </div>

  <div class="form-actions">
    <%= f.submit(project.persisted? ? "Save" : "Create project", class: "btn btn-primary") %>
  </div>
<% end %>
