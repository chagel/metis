<%# Breaks out of the #main frame so a save reloads the full page — the
    sidebar project list must pick up the new/renamed project (mirrors the
    new-chat form). %>
<%= form_with model: project, url: project.persisted? ? project_path(project) : projects_path,
      class: "conn-form", data: { turbo_frame: "_top" } do |f| %>
  <% if project.errors.any? %>
    <div class="flash error"><%= project.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, placeholder: "Metis", autocomplete: "off" %>
    <p class="field-hint"><%= t('.name_hint') %></p>
  </div>

  <div class="field">
    <%= f.label :github_repo, t('.github_repo_label') %>
    <%= f.text_field :github_repo, placeholder: "owner/repo", autocomplete: "off" %>
    <p class="field-hint"><%= t('.github_repo_hint') %></p>
  </div>

  <div class="field">
    <%= f.label :about, t('.about_label') %>
    <%= f.text_area :about, rows: 5,
          placeholder: t('.about_placeholder') %>
    <p class="field-hint"><%= t('.about_hint') %></p>
  </div>

  <div class="form-actions">
    <%= f.submit(project.persisted? ? t('common.save') : t('.create'), class: "btn btn-primary") %>
  </div>
<% end %>
