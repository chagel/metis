<%# Breaks out of the #main frame so a save reloads the full page — the
    sidebar project list must pick up the new/renamed project (mirrors the
    new-chat form). %>
<%= form_with model: project, url: project.persisted? ? project_path(project) : projects_path,
      class: "conn-form", data: { turbo_frame: "_top" } do |f| %>
  <% if project.errors.any? %>
    <div class="flash error"><%= project.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, placeholder: "Metis", autocomplete: "off" %>
    <p class="field-hint"><%= t('.name_hint') %></p>
  </div>

  <div class="field">
    <%= f.label :github_repo, t('.github_repo_label') %>
    <%= f.text_field :github_repo, placeholder: "owner/repo", autocomplete: "off" %>
    <p class="field-hint"><%= t('.github_repo_hint') %></p>
  </div>

  <div class="field" data-controller="linear-projects"
       data-linear-projects-url-value="<%= linear_projects_projects_path %>"
       data-loading-text="<%= t('.linear_project_loading') %>">
    <%= f.label :linear_project, t('.linear_project_label') %>
    <div class="picker-row">
      <%= f.select :linear_project,
            options_for_select(project.linear_project.present? ? [ project.linear_project ] : [], project.linear_project),
            { include_blank: "—" },
            data: { "linear-projects-target": "select" } %>
      <button type="button" class="ico-btn" data-action="linear-projects#refresh"
              title="<%= t('.linear_project_refresh') %>">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M13 8a5 5 0 1 1-1.5-3.6M13 3v2h-2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
    <p class="field-hint">
      <%= t('.linear_project_hint') %>
      <span class="field-status" data-linear-projects-target="status"></span>
    </p>
  </div>

  <div class="field">
    <%= f.label :about, t('.about_label') %>
    <%= f.text_area :about, rows: 5,
          placeholder: t('.about_placeholder') %>
    <p class="field-hint"><%= t('.about_hint') %></p>
  </div>

  <div class="form-actions">
    <%= f.submit(project.persisted? ? t('common.save') : t('.create'), class: "btn btn-primary") %>
  </div>
<% end %>
