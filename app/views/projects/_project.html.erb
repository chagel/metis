<%# Managers edit a project; members see it read-only. %>
<%= content_tag(team_manager? ? :a : :div, class: "conn-row",
      href: (team_manager? ? edit_project_path(project) : nil)) do %>
  <div class="conn-main">
    <div class="conn-name"><%= project.name %></div>
    <% if project.about.present? %>
      <div class="conn-sub"><%= truncate(project.about, length: 120) %></div>
    <% end %>
  </div>
<% end %>
