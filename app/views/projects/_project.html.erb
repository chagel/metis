<%# The card opens the project dashboard (team-visible); editing is an
    admin affordance reached from there. %>
<%= link_to project_path(project), class: "conn-row" do %>
  <div class="conn-main">
    <div class="conn-name"><%= project.name %></div>
    <% if project.github_repo.present? %>
      <div class="conn-repo"><%= project.github_repo %></div>
    <% end %>
    <% if project.about.present? %>
      <div class="conn-sub"><%= truncate(project.about, length: 120) %></div>
    <% end %>
  </div>
<% end %>
