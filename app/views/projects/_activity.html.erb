<section class="proj-activity">
  <h2 class="proj-activity-title"><%= t('projects.activity.title') %></h2>

  <% if activity.empty? %>
    <p class="field-hint"><%= t('projects.activity.empty') %></p>
  <% else %>
    <ul class="activity-list">
      <% activity.each do |event| %>
        <% entry = event.present %>
        <li class="activity-item">
          <% if entry.avatar_url %>
            <%= image_tag entry.avatar_url, width: 24, height: 24, class: "activity-avatar",
                  alt: "", loading: "lazy", referrerpolicy: "no-referrer" %>
          <% end %>
          <span class="activity-text">
            <span class="activity-actor"><%= entry.actor %></span>
            <% if entry.url %>
              <%= link_to entry.summary, entry.url, class: "activity-summary",
                    target: "_blank", rel: "noopener" %>
            <% else %>
              <span class="activity-summary"><%= entry.summary %></span>
            <% end %>
          </span>
          <time class="activity-time" datetime="<%= entry.created_at.iso8601 %>">
            <%= t('projects.activity.ago', time: time_ago_in_words(entry.created_at)) %>
          </time>
        </li>
      <% end %>
    </ul>

    <% if total > activity.size %>
      <p class="field-hint"><%= t('projects.activity.showing', count: activity.size, total: total) %></p>
    <% end %>
  <% end %>
</section>
