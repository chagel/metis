<% content_for :title, t('.title') %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title"><%= t('.heading') %></h1>
    <div style="flex:1"></div>
    <%= link_to t('common.cancel'), projects_path, class: "btn btn-ghost" %>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <%= render "form", project: @project, available_providers: @available_providers %>
    </div>
  </div>
</main>
