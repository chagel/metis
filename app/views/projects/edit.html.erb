<% content_for :title, @project.name %>

<main class="pane">
  <header class="pane-head">
    <%= link_to project_path(@project), class: "ico-btn", title: t('.back') do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M10 3L5 8l5 5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    <% end %>
    <h1 class="pane-title"><%= @project.name %></h1>
    <div style="flex:1"></div>
    <%= button_to t('common.delete'), project_path(@project), method: :delete, class: "btn btn-danger",
          form: { data: { turbo_confirm: t('.delete_confirm', name: @project.name) } } %>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <%= render "form", project: @project, available_providers: @available_providers %>
    </div>
  </div>
</main>
