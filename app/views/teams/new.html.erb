<% content_for :title, t('.title') %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title"><%= t('.heading') %></h1>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <p class="pane-lead">
        <%= t('.lead') %>
      </p>

      <%= form_with model: @team, url: teams_path, class: "team-form" do |form| %>
        <% if @team.errors.any? %>
          <div class="form-flash form-flash-err">
            <%= pluralize(@team.errors.count, "error") %> <%= t('.errors_prevented') %>
            <ul>
              <% @team.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="field">
          <%= form.label :name, t('.team_name') %>
          <%= form.text_field :name, autofocus: true, placeholder: "Acme Engineering" %>
          <p class="field-hint"><%= t('.rename_hint') %></p>
        </div>

        <div class="form-actions">
          <%= link_to t('common.cancel'), team_path, class: "btn btn-ghost" %>
          <%= form.submit t('.create_team'), class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</main>
