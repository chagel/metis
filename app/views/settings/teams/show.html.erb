<% content_for :title, t('.title') %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title"><%= @team.personal? ? t('.personal_workspace') : @team.name %></h1>
    <div style="flex:1"></div>
    <% unless @team.personal? %>
      <%= button_to switch_team_path(current_user.personal_team), method: :post,
            params: { to: "settings" }, form: { data: { turbo_frame: "_top" } },
            class: "btn btn-ghost btn-back" do %>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 3L5 8l5 5"/>
        </svg>
        <span><%= t('.all_teams') %></span>
      <% end %>
    <% end %>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <% if @team.personal? %>
        <p class="pane-lead">
          <%= t('.personal_lead') %>
        </p>

        <section class="settings-card">
          <div class="settings-card-head">
            <span class="settings-card-title"><%= t('.your_teams') %></span>
            <% if @joined_teams.any? %>
              <span class="settings-card-count"><%= @joined_teams.size %></span>
            <% end %>
          </div>

          <div class="team-pick-list">
            <% @joined_teams.each do |membership| %>
              <% team = membership.team %>
              <%= button_to switch_team_path(team), method: :post,
                    params: { to: "settings" }, form: { data: { turbo_frame: "_top" } },
                    class: "team-pick", title: t('.open_team', name: team.name) do %>
                <span class="team-mono"><%= team.name.first.upcase %></span>
                <span class="team-pick-id">
                  <span class="team-pick-name"><%= team.name %></span>
                  <span class="team-pick-meta">
                    <%= pluralize(team.memberships.size, "member") %> · <%= membership.role.titleize %>
                  </span>
                </span>
                <svg class="team-pick-go" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 3l5 5-5 5"/>
                </svg>
              <% end %>
            <% end %>

            <% if @joined_teams.any? %><hr class="card-divider"><% end %>

            <%= link_to new_team_path, class: "team-pick team-add" do %>
              <span class="team-mono">+</span>
              <span class="team-pick-id">
                <span class="team-pick-name"><%= t('.new_team') %></span>
                <span class="team-pick-meta"><%= t('.new_team_meta') %></span>
              </span>
            <% end %>
          </div>
        </section>
      <% else %>
        <% manager = team_manager? %>
        <% owner = current_membership&.owner? %>
        <p class="pane-lead">
          <%= t('.team_lead') %>
        </p>

        <%# Group one: the team as it stands — its name and who's in it. %>
        <section class="settings-card">
          <% if manager %>
            <%= form_with model: @team, url: team_path, method: :patch, class: "team-rename" do |form| %>
              <%= form.label :name, t('.team_name'), class: "team-form-label" %>
              <div class="team-rename-row">
                <%= form.text_field :name, class: "team-input" %>
                <%= form.submit t('common.save'), class: "btn btn-ghost" %>
              </div>
            <% end %>
          <% end %>

          <div class="settings-card-sub"><%= t('.members') %> · <%= @memberships.size %></div>
          <ul class="member-list">
            <% @memberships.each do |membership| %>
              <li class="member-row">
                <%= avatar_for membership.user, size: 32 %>
                <div class="member-id">
                  <div class="member-name"><%= membership.user.display_label %></div>
                  <div class="member-email"><%= membership.user.email %></div>
                </div>
                <span class="member-role"><%= membership.role.titleize %></span>
                <% if manager && !membership.owner? && membership.user_id != current_user.id %>
                  <div class="member-actions">
                    <% next_role = membership.member? ? "admin" : "member" %>
                    <%= button_to t('.make_role', role: next_role), team_membership_path(membership), method: :patch,
                          params: { membership: { role: next_role } }, form_class: "inline-form",
                          class: "btn btn-ghost btn-sm" %>
                    <% if owner %>
                      <%= button_to t('.make_owner'), transfer_team_membership_path(membership), method: :post,
                            form: { class: "inline-form", data: { turbo_confirm: t('.make_owner_confirm', name: membership.user.display_label) } },
                            class: "btn btn-ghost btn-sm" %>
                    <% end %>
                    <%= button_to t('common.remove'), team_membership_path(membership), method: :delete,
                          form: { class: "inline-form", data: { turbo_confirm: t('.remove_confirm', name: membership.user.display_label, team: @team.name) } },
                          class: "btn btn-ghost btn-sm" %>
                  </div>
                <% end %>
              </li>
            <% end %>
          </ul>

          <div class="settings-danger">
            <% if owner %>
              <%= button_to t('.delete_team'), team_path, method: :delete, class: "btn btn-danger",
                    form: { data: { turbo_confirm: t('.delete_team_confirm', team: @team.name) } } %>
            <% else %>
              <%= button_to t('.leave_team'), leave_team_memberships_path, method: :delete, class: "btn btn-danger",
                    form: { data: { turbo_confirm: t('.leave_team_confirm', team: @team.name) } } %>
            <% end %>
          </div>
        </section>

        <%# Group two: people in flight — the invite form and who's pending. %>
        <% if manager %>
          <section class="settings-card">
            <div class="settings-card-head">
              <span class="settings-card-title"><%= t('.invitations') %></span>
              <% if @pending_invitations.any? %>
                <span class="settings-card-count"><%= t('.count_pending', count: @pending_invitations.size) %></span>
              <% end %>
            </div>

            <%= form_with model: @invitation, url: team_invitations_path, class: "invite-form" do |form| %>
              <div class="invite-row">
                <%= form.email_field :email, placeholder: "teammate@example.com", "aria-label": t('.email'), class: "team-input" %>
                <%= form.select :role, Invitation::INVITABLE_ROLES.map { |r| [ r.titleize, r ] }, {}, class: "team-input" %>
                <%= form.submit t('.send_invite'), class: "btn btn-primary" %>
              </div>
            <% end %>

            <% if @pending_invitations.any? %>
              <hr class="card-divider">
              <ul class="invite-list">
                <% @pending_invitations.each do |invitation| %>
                  <li class="invite-pending">
                    <div class="invite-pending-id">
                      <div class="invite-pending-email"><%= invitation.email %></div>
                      <div class="invite-pending-meta"><%= t('.invited_as', role: invitation.role.titleize) %></div>
                    </div>
                    <span class="badge-pending"><%= t('.pending') %></span>
                    <%= button_to t('.resend'), resend_team_invitation_path(invitation), method: :post,
                          form_class: "inline-form", class: "btn btn-ghost btn-sm" %>
                    <%= button_to t('.revoke'), team_invitation_path(invitation), method: :delete,
                          form_class: "inline-form", class: "btn btn-ghost btn-sm" %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <p class="invite-empty"><%= t('.no_pending') %></p>
            <% end %>
          </section>
        <% end %>
      <% end %>
    </div>
  </div>
</main>
