<% content_for :title, t(".title") %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title"><%= t(".title") %></h1>
  </header>

  <div class="pane-body">
  <div class="pane-inner">
  <p class="routine-hint"><%= t(".hint_html", link: link_to(t(".hunches"), hunches_path)) %></p>

  <%= form_with model: @direction, url: directions_path, class: "conn-form direction-form" do |f| %>
    <% if @direction.errors.any? %>
      <div class="flash error"><%= @direction.errors.full_messages.to_sentence %></div>
    <% end %>
    <div class="field">
      <%= f.label :title, t(".title_label") %>
      <%= f.text_field :title, placeholder: t(".title_placeholder"), autocomplete: "off" %>
    </div>
    <div class="field">
      <%= f.label :brief, t(".brief_label") %>
      <%= f.text_area :brief, rows: 2, placeholder: t(".brief_placeholder") %>
    </div>
    <div class="form-actions"><%= f.submit t(".add"), class: "btn btn-primary" %></div>
  <% end %>

  <div class="conn-list">
    <% @directions.each do |direction| %>
      <% counts = direction.hunches.group(:status).count %>
      <div class="conn-row direction-row <%= "is-paused" if direction.paused? %>">
        <div class="conn-main">
          <div class="conn-name">
            <%= direction.title %>
            <% if direction.paused? %><span class="badge"><%= t(".paused") %></span><% end %>
          </div>
          <% if direction.brief.present? %><div class="direction-brief"><%= direction.brief %></div><% end %>
          <div class="conn-sub routine-meta">
            <span><%= direction.last_explored_at ? t(".explored", time: time_ago_in_words(direction.last_explored_at)) : t(".not_explored") %></span>
            <span><%= t(".outcomes", used: counts.fetch("used", 0), dismissed: counts.fetch("dismissed", 0), total: counts.values.sum) %></span>
          </div>
          <% if direction.view.present? || direction.open_questions.any? %>
            <details class="direction-state">
              <summary><%= t(".current_view") %></summary>
              <% if direction.view.present? %><div class="chat-content"><%= markdown(direction.view) %></div><% end %>
              <% if direction.open_questions.any? %>
                <p class="field-sublabel"><%= t(".open_questions") %></p>
                <ul><% direction.open_questions.each do |question| %><li><%= question %></li><% end %></ul>
              <% end %>
            </details>
          <% end %>
        </div>
        <div class="conn-actions">
          <%= button_to t("common.delete"), direction_path(direction), method: :delete, class: "btn btn-ghost btn-sm",
                form: { data: { turbo_confirm: t(".delete_confirm", title: direction.title) } } %>
          <% label = t(direction.active? ? ".pause" : ".resume", title: direction.title) %>
          <%= button_to "", toggle_direction_path(direction), method: :patch, form_class: "inline-form",
                class: "switch #{'is-on' if direction.active?}", title: label,
                role: "switch", aria: { checked: direction.active?.to_s, label: label } %>
        </div>
      </div>
    <% end %>
  </div>
</div>
  </div>
</main>
