<% content_for :title, t('.title') %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title"><%= t('.heading') %></h1>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <%= form_with model: @user, url: account_path, method: :patch, class: "account-form" do |form| %>
        <% if flash[:notice].present? %>
          <div class="form-flash form-flash-ok"><%= flash[:notice] %></div>
        <% end %>
        <% if @user.errors.any? %>
          <div class="form-flash form-flash-err">
            <%= pluralize(@user.errors.count, "error") %> <%= t('.errors_prevented') %>
            <ul>
              <% @user.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <section class="settings-card">
          <fieldset class="account-fieldset">
            <legend><%= t('.email_legend') %></legend>
            <div class="form-row">
              <%= form.label :email, t('.email_label') %>
              <%= form.email_field :email, autocomplete: "email" %>
              <p class="form-hint"><%= t('.email_hint') %></p>
            </div>
          </fieldset>

          <fieldset class="account-fieldset">
            <legend><%= t('.password_legend') %></legend>
            <div class="form-row">
              <%= form.label :password, t('.new_password') %>
              <%= form.password_field :password, autocomplete: "new-password" %>
              <p class="form-hint"><%= t('.new_password_hint') %></p>
            </div>
            <div class="form-row">
              <%= form.label :password_confirmation, t('.confirm_new_password') %>
              <%= form.password_field :password_confirmation, autocomplete: "new-password" %>
            </div>
          </fieldset>

          <fieldset class="account-fieldset">
            <legend><%= t('.confirm_legend') %></legend>
            <div class="form-row">
              <%= form.label :current_password, t('.current_password') %>
              <%= form.password_field :current_password, autocomplete: "current-password" %>
              <p class="form-hint">
                <%= t('.current_password_hint') %>
                <% if @user.identities.exists? %>
                  <%= t('.social_signup') %>
                  <%= link_to t('.set_password'), new_user_password_path, data: { turbo_frame: "_top" } %> <%= t('.first') %>
                <% end %>
              </p>
            </div>
          </fieldset>

          <div class="form-actions">
            <%= form.submit t('.save_changes'), class: "btn btn-primary" %>
          </div>
        </section>
      <% end %>

      <% if @identities.any? %>
        <section class="settings-card">
          <div class="settings-card-head">
            <span class="settings-card-title"><%= t('.connected_accounts') %></span>
          </div>
          <p class="form-hint"><%= t('.connected_accounts_hint') %></p>
          <ul class="identity-list">
            <% @identities.each do |identity| %>
              <li class="identity-row">
                <span class="identity-badge">
                  <%= render "settings/accounts/provider_glyph", provider: identity.provider %>
                </span>
                <span class="identity-id">
                  <span class="identity-provider"><%= identity_provider_label(identity.provider) %></span>
                  <span class="identity-meta"><%= t('.connected') %></span>
                </span>
                <svg class="identity-check" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3.5 8.5l3 3 6-7"/>
                </svg>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <section class="settings-card">
        <div class="settings-card-head">
          <span class="settings-card-title"><%= t('.local_bridge') %></span>
        </div>
        <p class="form-hint">
          <%= t('.local_bridge_hint_pre') %> <strong><%= t('.local') %></strong> <%= t('.local_bridge_hint_post') %>
        </p>

        <% if @user.bridge_token_digest.present? %>
          <% if @new_bridge_token.present? %>
            <div class="bridge-status bridge-status--fresh">
              <span class="dev-dot"></span>
              <span class="form-hint"><%= t('.token_generated_once') %></span>
            </div>
          <% else %>
            <div class="bridge-status">
              <span class="dev-dot on"></span>
              <span class="form-hint">
                <%= t('.token_active') %>
                <% if @user.bridge_seen_at %>
                  <%= t('.machine_connected', machine: @user.bridge_client.presence || t('.a_machine'), ago: time_ago_in_words(@user.bridge_seen_at)) %>
                <% else %>
                  <%= t('.no_machine_yet') %>
                <% end %>
              </span>
            </div>
          <% end %>

          <%= form_with model: @user, url: account_bridge_prefs_path, method: :patch,
                class: "bridge-mode-form", data: { controller: "auto-submit" } do |f| %>
            <fieldset class="bridge-mode-selector">
              <legend class="bridge-mode-legend"><%= t('.claim_mode') %></legend>
              <div class="bridge-mode-opts">
                <label class="bridge-mode-opt">
                  <%= f.radio_button :auto_claim_tasks, true,
                        checked: @user.auto_claim_tasks,
                        data: { action: "change->auto-submit#submit" } %>
                  <span class="bridge-mode-chip">
                    <span class="bridge-mode-dot bridge-mode-dot--auto"></span>
                    <%= t('.mode_auto') %>
                  </span>
                </label>
                <label class="bridge-mode-opt">
                  <%= f.radio_button :auto_claim_tasks, false,
                        checked: !@user.auto_claim_tasks,
                        data: { action: "change->auto-submit#submit" } %>
                  <span class="bridge-mode-chip">
                    <span class="bridge-mode-dot bridge-mode-dot--manual"></span>
                    <%= t('.mode_manual') %>
                  </span>
                </label>
              </div>
            </fieldset>
          <% end %>

          <div class="bridge-instr">
            <% if @user.auto_claim_tasks %>
              <div class="bridge-instr-head">
                <span class="bridge-instr-title"><%= t('.daemon_setup') %></span>
                <span class="bridge-instr-badge"><%= t('.mode_auto') %></span>
              </div>
              <p class="form-hint"><%= t('.auto_desc') %></p>
              <%= render "settings/accounts/bridge_auto_instructions",
                    token: bridge_token_for_display(@user, @new_bridge_token),
                    fresh_token: @new_bridge_token.present?,
                    host: request.host, base_url: request.base_url,
                    skill_url: api_bridge_skill_url %>
            <% else %>
              <div class="bridge-instr-head">
                <span class="bridge-instr-title"><%= t('.manual_claim') %></span>
                <span class="bridge-instr-badge bridge-instr-badge--manual"><%= t('.mode_manual') %></span>
              </div>
              <p class="form-hint"><%= t('.manual_desc') %></p>
              <%= render "settings/accounts/bridge_manual_instructions",
                    token: bridge_token_for_display(@user, @new_bridge_token),
                    fresh_token: @new_bridge_token.present?,
                    base_url: request.base_url, skill_url: api_bridge_skill_url %>
            <% end %>
          </div>

          <div class="danger-row">
            <p class="form-hint"><%= t('.regenerate_revokes') %></p>
            <%= button_to t('.regenerate_token'), account_bridge_token_path,
                  method: :post, class: "btn btn-ghost", form: { class: "inline-form" } %>
          </div>
        <% else %>
          <div class="danger-row">
            <p class="form-hint"><%= t('.no_token_yet') %></p>
            <%= button_to t('.generate_token'), account_bridge_token_path,
                  method: :post, class: "btn btn-ghost", form: { class: "inline-form" } %>
          </div>
        <% end %>
      </section>

      <section class="settings-card settings-card-danger">
        <div class="settings-card-head">
          <span class="settings-card-title"><%= t('.delete_account') %></span>
        </div>
        <div class="danger-row">
          <p class="form-hint"><%= t('.delete_account_hint') %></p>
          <%= button_to t('.delete_account'), account_path, method: :delete, class: "btn btn-danger",
                form: { class: "inline-form", data: { turbo_frame: "_top",
                                turbo_confirm: t('.delete_account_confirm') } } %>
        </div>
      </section>
    </div>
  </div>
</main>
