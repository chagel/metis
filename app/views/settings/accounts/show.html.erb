<% content_for :title, t('.title') %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title"><%= t('.heading') %></h1>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <%= form_with model: @user, url: account_path, method: :patch, class: "account-form" do |form| %>
        <% if flash[:notice].present? %>
          <div class="form-flash form-flash-ok"><%= flash[:notice] %></div>
        <% end %>
        <% if @user.errors.any? %>
          <div class="form-flash form-flash-err">
            <%= pluralize(@user.errors.count, "error") %> <%= t('.errors_prevented') %>
            <ul>
              <% @user.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <section class="settings-card">
          <fieldset class="account-fieldset">
            <legend><%= t('.email_legend') %></legend>
            <div class="form-row">
              <%= form.label :email, t('.email_label') %>
              <%= form.email_field :email, autocomplete: "email" %>
              <p class="form-hint"><%= t('.email_hint') %></p>
            </div>
          </fieldset>

          <fieldset class="account-fieldset">
            <legend><%= t('.password_legend') %></legend>
            <div class="form-row">
              <%= form.label :password, t('.new_password') %>
              <%= form.password_field :password, autocomplete: "new-password" %>
              <p class="form-hint"><%= t('.new_password_hint') %></p>
            </div>
            <div class="form-row">
              <%= form.label :password_confirmation, t('.confirm_new_password') %>
              <%= form.password_field :password_confirmation, autocomplete: "new-password" %>
            </div>
          </fieldset>

          <fieldset class="account-fieldset">
            <legend><%= t('.confirm_legend') %></legend>
            <div class="form-row">
              <%= form.label :current_password, t('.current_password') %>
              <%= form.password_field :current_password, autocomplete: "current-password" %>
              <p class="form-hint">
                <%= t('.current_password_hint') %>
                <% if @user.identities.exists? %>
                  <%= t('.social_signup') %>
                  <%= link_to t('.set_password'), new_user_password_path, data: { turbo_frame: "_top" } %> <%= t('.first') %>
                <% end %>
              </p>
            </div>
          </fieldset>

          <div class="form-actions">
            <%= form.submit t('.save_changes'), class: "btn btn-primary" %>
          </div>
        </section>
      <% end %>

      <% if @identities.any? %>
        <section class="settings-card">
          <div class="settings-card-head">
            <span class="settings-card-title"><%= t('.connected_accounts') %></span>
          </div>
          <p class="form-hint"><%= t('.connected_accounts_hint') %></p>
          <ul class="identity-list">
            <% @identities.each do |identity| %>
              <li class="identity-row">
                <span class="identity-badge">
                  <%= render "settings/accounts/provider_glyph", provider: identity.provider %>
                </span>
                <span class="identity-id">
                  <span class="identity-provider"><%= identity_provider_label(identity.provider) %></span>
                  <span class="identity-meta"><%= t('.connected') %></span>
                </span>
                <svg class="identity-check" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3.5 8.5l3 3 6-7"/>
                </svg>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <section class="settings-card">
        <div class="settings-card-head">
          <span class="settings-card-title"><%= t('.local_bridge') %></span>
        </div>
        <p class="form-hint">
          <%= t('.local_bridge_hint_pre') %> <strong><%= t('.local') %></strong> <%= t('.local_bridge_hint_post') %>
        </p>

        <% if @new_bridge_token.present? %>
          <% bridge_setup = <<~TEXT.strip
            Set up the Metis bridge daemon on this machine. It runs as a login service, auto-claims workflow steps marked Local, and works them with my own coding agent in per-task git worktrees.

            1. Install the daemon (one static Go binary):

            go install github.com/chagel/metis/clients/metis@latest
            # or from a checkout: cd clients/metis && go build -o /usr/local/bin/metis .

            2. Write ~/.metis/config.json (`metis init` scaffolds it) — the daemon only claims steps whose Metis project is mapped to a checkout here:

            {
              "agent": "claude",
              "servers": [
                {
                  "name": "#{request.host}",
                  "server": "#{request.base_url}",
                  "token": "#{@new_bridge_token}",
                  "projects": { "<metis project name>": "~/path/to/its/checkout" }
                }
              ]
            }

            3. Install it as a login service and verify it polls:

            metis install
            tail -5 ~/.metis/daemon.log

            4. Optional: install the ops guide where you discover skills, for future troubleshooting:

            curl -fsSL --create-dirs #{api_bridge_skill_url} -o ~/.claude/skills/metis-bridge/SKILL.md
          TEXT
          %>
          <div class="bridge-token">
            <p class="bridge-token-hint">
              <%= t('.bridge_token_hint') %>
            </p>
            <div class="token-row">
              <pre class="token bridge-paste"><%= bridge_setup %></pre>
              <button type="button" class="token-copy" title="<%= t('.copy_instructions') %>"
                      aria-label="<%= t('.copy_instructions_aria') %>"
                      data-controller="copy"
                      data-copy-text-value="<%= bridge_setup %>"
                      data-action="copy#copy">
                <svg class="ico-copy" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"/>
                  <path d="M3.4 10.5A1.4 1.4 0 0 1 2.5 9.2V3.6A1.4 1.4 0 0 1 3.9 2.2h5.3a1.4 1.4 0 0 1 1.3.9"/>
                </svg>
                <svg class="ico-check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3.5 8.4l3 3 6-6.2"/>
                </svg>
                <span class="lbl-copy"><%= t('.copy') %></span>
                <span class="lbl-done"><%= t('.copied') %></span>
              </button>
            </div>
          </div>
        <% end %>

        <div class="danger-row">
          <p class="form-hint">
            <% if @user.bridge_token_digest.present? %>
              <%= t('.token_active') %>
              <% if @user.bridge_seen_at %>
                <%= t('.machine_connected', machine: @user.bridge_client.presence || t('.a_machine'), ago: time_ago_in_words(@user.bridge_seen_at)) %>
              <% else %>
                <%= t('.no_machine_yet') %>
              <% end %>
              <%= t('.regenerate_revokes') %>
            <% else %>
              <%= t('.no_token_yet') %>
            <% end %>
          </p>
          <%= button_to (@user.bridge_token_digest.present? ? t('.regenerate_token') : t('.generate_token')),
                account_bridge_token_path, method: :post, class: "btn btn-ghost",
                form: { class: "inline-form" } %>
        </div>
      </section>

      <section class="settings-card settings-card-danger">
        <div class="settings-card-head">
          <span class="settings-card-title"><%= t('.delete_account') %></span>
        </div>
        <div class="danger-row">
          <p class="form-hint"><%= t('.delete_account_hint') %></p>
          <%= button_to t('.delete_account'), account_path, method: :delete, class: "btn btn-danger",
                form: { class: "inline-form", data: { turbo_frame: "_top",
                                turbo_confirm: t('.delete_account_confirm') } } %>
        </div>
      </section>
    </div>
  </div>
</main>
