<% content_for :title, "Account" %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title">Account</h1>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <%= form_with model: @user, url: account_path, method: :patch, class: "account-form" do |form| %>
        <% if flash[:notice].present? %>
          <div class="form-flash form-flash-ok"><%= flash[:notice] %></div>
        <% end %>
        <% if @user.errors.any? %>
          <div class="form-flash form-flash-err">
            <%= pluralize(@user.errors.count, "error") %> prevented saving your account:
            <ul>
              <% @user.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <section class="settings-card">
          <fieldset class="account-fieldset">
            <legend>Email</legend>
            <div class="form-row">
              <%= form.label :email, "Email address" %>
              <%= form.email_field :email, autocomplete: "email" %>
              <p class="form-hint">Used to sign in and for account notifications.</p>
            </div>
          </fieldset>

          <fieldset class="account-fieldset">
            <legend>Password</legend>
            <div class="form-row">
              <%= form.label :password, "New password" %>
              <%= form.password_field :password, autocomplete: "new-password" %>
              <p class="form-hint">Leave blank to keep your current password.</p>
            </div>
            <div class="form-row">
              <%= form.label :password_confirmation, "Confirm new password" %>
              <%= form.password_field :password_confirmation, autocomplete: "new-password" %>
            </div>
          </fieldset>

          <fieldset class="account-fieldset">
            <legend>Confirm changes</legend>
            <div class="form-row">
              <%= form.label :current_password, "Current password" %>
              <%= form.password_field :current_password, autocomplete: "current-password" %>
              <p class="form-hint">
                Required to save any change.
                <% if @user.identities.exists? %>
                  Signed up with a social account?
                  <%= link_to "Set a password", new_user_password_path, data: { turbo_frame: "_top" } %> first.
                <% end %>
              </p>
            </div>
          </fieldset>

          <div class="form-actions">
            <%= form.submit "Save changes", class: "btn btn-primary" %>
          </div>
        </section>
      <% end %>

      <% if @identities.any? %>
        <section class="settings-card">
          <div class="settings-card-head">
            <span class="settings-card-title">Connected accounts</span>
          </div>
          <p class="form-hint">Sign-in providers linked to your account.</p>
          <ul class="identity-list">
            <% @identities.each do |identity| %>
              <li class="identity-row">
                <span class="identity-badge">
                  <%= render "settings/accounts/provider_glyph", provider: identity.provider %>
                </span>
                <span class="identity-id">
                  <span class="identity-provider"><%= identity_provider_label(identity.provider) %></span>
                  <span class="identity-meta">Connected</span>
                </span>
                <svg class="identity-check" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3.5 8.5l3 3 6-7"/>
                </svg>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <section class="settings-card">
        <div class="settings-card-head">
          <span class="settings-card-title">Local bridge</span>
        </div>
        <p class="form-hint">
          A workflow step set to <strong>Local</strong> runs on your own machine: a
          local agent pulls it with this token, works in your real repo with your
          own credentials, and reports the result. Treat the token like a password.
        </p>

        <% if @new_bridge_token.present? %>
          <% bridge_setup = <<~TEXT.strip
            Set up the Metis bridge daemon on this machine. It runs as a login service, auto-claims workflow steps marked Local, and works them with my own coding agent in per-task git worktrees.

            1. Install the daemon (one static Go binary):

            go install github.com/chagel/metis/clients/metis@latest
            # or from a checkout: cd clients/metis && go build -o /usr/local/bin/metis .

            2. Write ~/.metis/config.json (`metis init` scaffolds it) — the daemon only claims steps whose Metis project is mapped to a checkout here:

            {
              "agent": "claude",
              "servers": [
                {
                  "name": "#{request.host}",
                  "server": "#{request.base_url}",
                  "token": "#{@new_bridge_token}",
                  "projects": { "<metis project name>": "~/path/to/its/checkout" }
                }
              ]
            }

            3. Install it as a login service and verify it polls:

            metis install
            tail -5 ~/.metis/daemon.log

            4. Optional: install the ops guide where you discover skills, for future troubleshooting:

            curl -fsSL --create-dirs #{api_bridge_skill_url} -o ~/.claude/skills/metis-bridge/SKILL.md
          TEXT
          %>
          <div class="bridge-token">
            <p class="bridge-token-hint">
              Shown once — paste this whole thing into the coding agent on your machine:
            </p>
            <div class="token-row">
              <pre class="token bridge-paste"><%= bridge_setup %></pre>
              <button type="button" class="token-copy" title="Copy setup instructions"
                      aria-label="Copy setup instructions to clipboard"
                      data-controller="copy"
                      data-copy-text-value="<%= bridge_setup %>"
                      data-action="copy#copy">
                <svg class="ico-copy" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"/>
                  <path d="M3.4 10.5A1.4 1.4 0 0 1 2.5 9.2V3.6A1.4 1.4 0 0 1 3.9 2.2h5.3a1.4 1.4 0 0 1 1.3.9"/>
                </svg>
                <svg class="ico-check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3.5 8.4l3 3 6-6.2"/>
                </svg>
                <span class="lbl-copy">Copy</span>
                <span class="lbl-done">Copied</span>
              </button>
            </div>
          </div>
        <% end %>

        <div class="danger-row">
          <p class="form-hint">
            <% if @user.bridge_token_digest.present? %>
              Token active.
              <% if @user.bridge_seen_at %>
                <%= @user.bridge_client.presence || "A machine" %> connected
                <%= time_ago_in_words(@user.bridge_seen_at) %> ago.
              <% else %>
                No machine has connected yet.
              <% end %>
              Regenerating revokes the current token.
            <% else %>
              No token yet — generate one to connect your machine.
            <% end %>
          </p>
          <%= button_to (@user.bridge_token_digest.present? ? "Regenerate token" : "Generate token"),
                account_bridge_token_path, method: :post, class: "btn btn-ghost",
                form: { class: "inline-form" } %>
        </div>
      </section>

      <section class="settings-card settings-card-danger">
        <div class="settings-card-head">
          <span class="settings-card-title">Delete account</span>
        </div>
        <div class="danger-row">
          <p class="form-hint">Permanently removes your account and conversations. This cannot be undone.</p>
          <%= button_to "Delete account", account_path, method: :delete, class: "btn btn-danger",
                form: { class: "inline-form", data: { turbo_frame: "_top",
                                turbo_confirm: "Delete your account? This permanently removes your conversations and cannot be undone." } } %>
        </div>
      </section>
    </div>
  </div>
</main>
