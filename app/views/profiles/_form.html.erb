<%# Profile settings form. Submits to PATCH /profile via the
    "profile_form" turbo frame so save errors re-render in place
    without nuking the rest of the page. Two-column layout: short
    preferences on the left, long-form personalization on the right.
    Collapses to a single column on mobile via .profile-form's grid.
    `html: { multipart: true }` because the avatar field uploads a
    file — Rails form_with does not auto-detect this with Turbo. %>
<%= form_with model: user, url: profile_path, method: :patch,
      data: { turbo_frame: "profile_form" }, class: "profile-form" do |form| %>
  <% if flash[:notice].present? %>
    <div class="form-flash form-flash-ok"><%= flash[:notice] %></div>
  <% end %>
  <% if user.errors.any? %>
    <div class="form-flash form-flash-err">
      <%= pluralize(user.errors.count, "error") %> <%= t('.errors_prevented') %>
      <ul>
        <% user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="profile-col">
    <h2 class="profile-col-title"><%= t('.preferences') %></h2>

    <div class="form-row">
      <label><%= t('.change_avatar') %></label>
      <%= render "avatar_editor", user: user %>
      <p class="form-hint"><%= t('.avatar_hint') %></p>
    </div>

    <div class="form-row">
      <%= form.label :display_name, t('.display_name') %>
      <%= form.text_field :display_name, autocomplete: "name",
            placeholder: t('.display_name_placeholder') %>
      <p class="form-hint"><%= t('.display_name_hint') %></p>
    </div>

    <div class="form-row">
      <%= form.label :timezone, t('.timezone') %>
      <%= form.select :timezone, timezone_options,
            { include_blank: t('.default') },
            autocomplete: "off" %>
      <p class="form-hint"><%= t('.timezone_hint') %></p>
    </div>

    <div class="form-row">
      <%= form.label :language, t('.language') %>
      <%= form.select :language,
            User::AVAILABLE_LANGUAGES.map { |code| [ language_label(code), code ] },
            include_blank: t('.default') %>
      <p class="form-hint"><%= t('.language_hint') %></p>
    </div>

    <div class="form-row">
      <%= form.label :preferred_model, t('.default_model') %>
      <%= form.select :preferred_model,
            grouped_options_for_select(Agent::Catalog.grouped_model_options, user.preferred_model),
            include_blank: t('.default') %>
      <p class="form-hint"><%= t('.default_model_hint') %></p>
    </div>

    <div class="form-row">
      <%= form.label :theme, t('.theme') %>
      <%= form.select :theme,
            User::THEMES.map { |key| [ key.capitalize, key ] },
            include_blank: t('.default') %>
      <p class="form-hint"><%= t('.theme_hint') %></p>
    </div>
  </div>

  <div class="profile-col">
    <h2 class="profile-col-title"><%= t('.personalization') %></h2>

    <div class="form-row">
      <%= form.label :about_you, t('.about_you') %>
      <%= form.text_area :about_you, rows: 6,
            placeholder: t('.about_you_placeholder') %>
      <p class="form-hint"><%= t('.about_you_hint') %></p>
    </div>

    <div class="form-row">
      <%= form.label :custom_instructions, t('.custom_instructions') %>
      <%= form.text_area :custom_instructions, rows: 10,
            placeholder: t('.custom_instructions_placeholder') %>
      <p class="form-hint"><%= t('.custom_instructions_hint') %></p>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit t('.submit'), class: "btn btn-primary" %>
  </div>
<% end %>
