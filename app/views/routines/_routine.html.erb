<div class="conn-row <%= "is-paused" unless routine.enabled? %>">
  <div class="conn-main">
    <div class="conn-name">
      <%= routine.name %>
      <% unless routine.enabled? %><span class="badge"><%= t(".disabled") %></span><% end %>
    </div>
    <div class="conn-sub"><%= routine_schedule_text(routine) %></div>
    <div class="conn-sub routine-meta">
      <% if routine.enabled? && routine.next_run_at&.future? %>
        <span><%= t(".next_run", time: time_ago_in_words(routine.next_run_at)) %></span>
      <% end %>
      <span><%= routine.last_run_at ? t(".last_run", time: time_ago_in_words(routine.last_run_at)) : t(".never_run") %></span>
      <% if routine.project %><span><%= routine.project.name %></span><% end %>
      <% if routine.visibility_team? %><span><%= t(".runs_as", name: routine.user.display_name.presence || routine.user.email) %></span><% end %>
    </div>
  </div>
  <% if routine.manageable_by?(current_user) %>
    <div class="conn-actions">
      <%# Break out of the settings #main frame so the redirect loads the
          full chat layout (sidebar included), not just the pane. %>
      <%= button_to t(".run"), run_routine_path(routine), class: "btn btn-ghost btn-sm",
            form: { data: { turbo_frame: "_top" } } %>
      <%= link_to t("common.edit"), edit_routine_path(routine), class: "btn btn-ghost btn-sm" %>
      <% label = t(routine.enabled? ? ".pause" : ".resume", name: routine.name) %>
      <%= button_to "", toggle_routine_path(routine), method: :patch, form_class: "inline-form",
            class: "switch #{'is-on' if routine.enabled?}", title: label,
            role: "switch", aria: { checked: routine.enabled?.to_s, label: label } %>
    </div>
  <% end %>
</div>
