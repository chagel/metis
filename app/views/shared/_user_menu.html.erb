<%# Sidebar user menu — the bottom-of-sidebar identity card, now a
    popup trigger. Houses Profile / Settings links, a live theme
    cycle button on the identity row that flips system → light →
    dark → system and persists via PATCH /profile/theme, and Sign
    out. Rendered by both the chat and settings sidebars so the
    surface is identical across the app. %>
<% theme_pref = (current_user.theme.presence || "system") %>
<div class="user-menu" data-controller="user-menu"
     data-user-menu-theme-url-value="<%= update_theme_profile_path %>"
     data-user-menu-theme-pref-value="<%= theme_pref %>"
     data-theme-pref="<%= theme_pref %>">
  <button type="button" class="user-menu-trigger"
          data-action="click->user-menu#toggle"
          aria-haspopup="true" aria-label="<%= t('.open_user_menu') %>">
    <%= avatar_for current_user, size: 32 %>
    <div class="who"><div class="nm"><%= current_user.display_label %></div></div>
    <svg class="user-menu-chev" viewBox="0 0 16 16" fill="none" stroke="currentColor"
         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 6l4 4 4-4"/>
    </svg>
  </button>

  <div class="user-menu-panel" data-user-menu-target="panel" role="menu">
    <div class="user-menu-id">
      <%= avatar_for current_user, size: 32 %>
      <div class="user-menu-id-text">
        <div class="user-menu-name"><%= current_user.display_label %></div>
        <div class="user-menu-email"><%= current_user.email %></div>
      </div>
      <button type="button" class="theme-toggle"
              data-action="click->user-menu#cycleTheme"
              aria-label="<%= t('.cycle_theme_aria') %>"
              title="<%= t('.cycle_theme') %>">
        <%# Each SVG is hidden unless the wrapper's data-theme-pref
            matches — so the visible icon always reflects the current
            preference (not the next state). Click cycles forward. %>
        <svg class="theme-toggle-icon theme-toggle-system" viewBox="0 0 16 16" fill="none"
             stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true">
          <rect x="2" y="3" width="12" height="9" rx="1.5"/>
          <path d="M6 14h4M8 12v2"/>
        </svg>
        <svg class="theme-toggle-icon theme-toggle-sun" viewBox="0 0 16 16" fill="none"
             stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true">
          <circle cx="8" cy="8" r="3"/>
          <path d="M8 1.5v1.5M8 13v1.5M1.5 8h1.5M13 8h1.5M3.3 3.3l1.1 1.1M11.6 11.6l1.1 1.1M3.3 12.7l1.1-1.1M11.6 4.4l1.1-1.1"/>
        </svg>
        <svg class="theme-toggle-icon theme-toggle-moon" viewBox="0 0 16 16" fill="none"
             stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true">
          <path d="M13.5 9.5A5.5 5.5 0 016.5 2.5a5.5 5.5 0 107 7z"/>
        </svg>
      </button>
    </div>

    <div class="user-menu-sep"></div>

    <%= link_to profile_path, class: "user-menu-item", role: "menuitem",
          data: { turbo_frame: "_top" } do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="8" cy="5.5" r="2.5"/><path d="M3 14c0-2.5 2.2-4.5 5-4.5s5 2 5 4.5"/>
      </svg>
      <span><%= t('.profile') %></span>
    <% end %>

    <%= link_to "/settings", class: "user-menu-item", role: "menuitem",
          data: { turbo_frame: "_top" } do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="8" cy="8" r="2.2"/>
        <path d="M13.5 8a5.5 5.5 0 00-.1-1.1l1.4-1-1.4-2.4-1.6.6a5.5 5.5 0 00-1.9-1.1L9.5 1h-3l-.4 1.9a5.5 5.5 0 00-1.9 1.1l-1.6-.6L1.2 5.9l1.4 1a5.5 5.5 0 000 2.2l-1.4 1 1.4 2.4 1.6-.6a5.5 5.5 0 001.9 1.1L6.5 15h3l.4-1.9a5.5 5.5 0 001.9-1.1l1.6.6 1.4-2.4-1.4-1c.07-.36.1-.73.1-1.1z"/>
      </svg>
      <span><%= t('.settings') %></span>
    <% end %>

    <div class="user-menu-sep"></div>

    <%= button_to destroy_user_session_path, method: :delete,
          class: "user-menu-item user-menu-signout", form: { data: { turbo: false } } do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 14H3.5A1.5 1.5 0 012 12.5v-9A1.5 1.5 0 013.5 2H6M10.5 11l3-3-3-3M13.5 8H6"/>
      </svg>
      <span><%= t('.sign_out') %></span>
    <% end %>
  </div>
</div>
