<h1 style="margin:0 0 16px; font-size:20px; line-height:28px; font-weight:700; color:#1c1917;">
  Reset your password
</h1>

<p style="margin:0 0 24px; font-size:15px; line-height:24px; color:#44403c;">
  We received a request to reset the password for your Metis account
  (<strong><%= @resource.email %></strong>).
</p>

<%= render "email/cta", url: edit_password_url(@resource, reset_password_token: @token), label: "Reset password" %>

<hr style="border:none; border-top:1px solid #e7e5e4; margin:0 0 20px;">

<p style="margin:0; font-size:13px; line-height:20px; color:#a8a29e;">
  If you didn't request this, you can safely ignore this email — your password
  won't change until you open the link above and choose a new one.
</p>
