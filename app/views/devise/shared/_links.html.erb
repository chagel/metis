<div class="auth-links">
  <% if controller_name != "sessions" %>
    <%= link_to t('.sign_in'), new_session_path(resource_name), class: "auth-link" %>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != "registrations" && registration_offered? %>
    <%= link_to t('.create_account'), new_registration_path(resource_name), class: "auth-link" %>
  <% end %>

  <% if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <%= link_to t('.forgot_password'), new_password_path(resource_name), class: "auth-link" %>
  <% end %>
</div>
