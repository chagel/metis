<div class="board-lane">
  <div class="board-lane-lbl">
    <div class="board-proj">
      <% if lane.project %>
        <%= link_to lane.project.name, board_path(projects: [ lane.project.id ]),
              class: "board-proj-link", title: t("board.filters.filter_project", name: lane.project.name) %>
      <% else %>
        <span class="board-proj-none"><%= t("board.index.no_project") %></span>
      <% end %>
    </div>
  </div>

  <% Board::COLUMNS.each do |column| %>
    <div class="board-cell">
      <% lane.columns[column].each do |run| %>
        <%= render "board/card", run: run, column: column %>
      <% end %>
      <% if lane.columns[column].empty? %>
        <div class="board-cell-empty"></div>
      <% end %>
    </div>
  <% end %>
</div>
