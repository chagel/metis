<%# The board's status bar: people presence on the left, bridge machines on
    the right. Each side opens its panel on hover (pointer) or tap (the
    shared `dropdown` controller). The bar carries a stable id so the ~20s
    poll and Phase 3 broadcasts can replace it. %>
<% gate_total = presence.people.sum(&:gate_count) %>
<% shown_people = presence.people.first(6) %>
<% people_overflow = presence.people.size - shown_people.size %>
<%# poll_query carries the board's active filters so the ~20s refetch stays
    in sync with the filtered grid; absent (broadcast re-render) → unfiltered. %>
<footer class="board-foot" id="board_actors"
        data-controller="poll"
        data-poll-url-value="<%= board_actors_path(local_assigns.fetch(:poll_query, {})) %>">
  <div class="board-side" data-controller="dropdown">
    <button type="button" class="board-side-bar" data-action="click->dropdown#toggle"
            aria-haspopup="true" aria-expanded="false"
            aria-controls="board_people_panel" aria-label="<%= t("board.actors.people") %>">
      <span class="board-actors-stack" title="<%= t("board.actors.summary_people", count: presence.people.size) %>">
        <% shown_people.each do |person| %>
          <span class="board-actors-av<%= " is-gated" unless person.idle? %>">
            <%= avatar_for person.member, size: 22, css: "board-actors-av-img" %>
          </span>
        <% end %>
        <% if people_overflow.positive? %>
          <span class="board-actors-ov"><%= t("board.actors.overflow", count: people_overflow) %></span>
        <% end %>
      </span>
      <% if gate_total.positive? %>
        <span class="board-actors-gates"><%= t("board.actors.gates_badge", count: gate_total) %></span>
      <% end %>
    </button>

    <div class="board-side-panel" id="board_people_panel" role="menu">
      <% presence.people.each do |person| %>
        <%= render "board/person_row", person: person %>
      <% end %>
    </div>
  </div>

  <div class="board-side board-side--r" data-controller="dropdown">
    <button type="button" class="board-side-bar" data-action="click->dropdown#toggle"
            aria-haspopup="true" aria-expanded="false"
            aria-controls="board_machines_panel" aria-label="<%= t("board.actors.machines") %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
      <span class="board-mono board-actors-ct"><%= t("board.actors.machines_summary", online: presence.online_count, total: presence.machines.size) %></span>
      <span class="board-actors-dots">
        <% presence.machines.first(6).each do |machine| %>
          <span class="board-dot <%= "board-dot--live" if machine.online? %>"></span>
        <% end %>
      </span>
    </button>

    <div class="board-side-panel" id="board_machines_panel" role="menu">
      <% if presence.machines.any? %>
        <% presence.machines.each do |machine| %>
          <%= render "board/machine_row", machine: machine %>
        <% end %>
      <% else %>
        <div class="board-actors-empty"><%= t("board.actors.no_machines") %></div>
      <% end %>
    </div>
  </div>
</footer>
