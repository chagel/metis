<div class="board-arow">
  <span class="board-arow-m">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
  </span>
  <div class="board-arow-main">
    <div class="board-arow-nm board-mono">
      <%= machine.owner.display_label %><% if machine.client.present? %> · <%= machine.client %><% end %>
    </div>
    <% if machine.task_ref %>
      <div class="board-arow-st"><%= t("board.actors.working", ref: machine.task_ref) %></div>
    <% end %>
  </div>
  <div class="board-arow-r">
    <span class="board-lite">
      <span class="board-dot <%= machine.online? ? "board-dot--live" : "" %>"></span>
      <%= t("board.actors.seen", ago: board_seen_ago(machine.seen_at)) %>
    </span>
  </div>
</div>
