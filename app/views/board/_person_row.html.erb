<div class="board-arow">
  <%= avatar_for person.member, size: 30, css: "board-arow-av" %>
  <div class="board-arow-main">
    <div class="board-arow-nm"><%= person.member.display_label %></div>
    <div class="board-arow-st">
      <% if person.idle? %>
        <%= t("board.rail.no_gates") %>
      <% else %>
        <%= t("board.rail.reviewing", ref: person.gate_ref) %>
      <% end %>
    </div>
  </div>
  <div class="board-arow-r">
    <% if person.idle? %>
      <span class="board-pill board-pill--idle"><%= t("board.rail.idle") %></span>
    <% else %>
      <span class="board-pill board-pill--gold"><%= t("board.rail.gate_count", count: person.gate_count) %></span>
    <% end %>
  </div>
</div>
