<% content_for :title, t(".title") %>

<main class="board">
  <header class="board-head">
    <div class="board-head-main">
      <h1><%= t(".title") %></h1>
      <%= render "board/filters" %>
    </div>
  </header>

  <%= render "board/grid", board: @board %>

  <%= render "board/actors", presence: @presence, poll_query: board_filter_query %>
</main>
