<% content_for :title, t(".title") %>

<main class="board">
  <header class="board-head">
    <div class="board-head-main">
      <h1><%= t(".title") %></h1>
      <div class="board-sub"><%= t(".subtitle", count: @board.count) %></div>
      <%= render "board/filters" %>
    </div>
    <%= render "board/actors", presence: @presence, poll_query: board_filter_query %>
  </header>

  <%= render "board/grid", board: @board %>

  <div class="board-foot"><%= t(".read_only") %></div>
</main>
