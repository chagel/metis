<% if message.user? && message.workflow_generated? %>
  <%# An engine-injected step prompt — a muted instruction, not a user bubble. %>
  <div id="<%= dom_id(message) %>" class="msg-step">
    <span class="msg-step-tag">Step</span>
    <div class="chat-content"><%= markdown(message.content) %></div>
  </div>
<% elsif message.user? %>
  <%# User: a contained bubble on the accent fill, aligned right. %>
  <div id="<%= dom_id(message) %>" class="msg-user">
    <div class="bubble">
      <% if message.attachments? %>
        <%= render "messages/attachments", message: message %>
      <% end %>
      <div id="<%= dom_id(message) %>_body"
           class="chat-content"><%= markdown(message.content) %></div>
    </div>
    <div class="msg-stamp"><%= time_ago_in_words(message.created_at) %> ago</div>
  </div>
<% else %>
  <%# Assistant: a card beside the agent mark, room for code and tables.
      The outer .msg-row is the stable element id — a turn error is
      broadcast-appended into it, landing below the card. %>
  <div id="<%= dom_id(message) %>" class="msg-row">
    <div class="msg-ai">
      <div class="ai-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 18.5V7l7 6.5 7-6.5v11.5"/>
        </svg>
      </div>
      <div class="ai-card">
        <% if message.attachments? %>
          <%= render "messages/attachments", message: message %>
        <% end %>

        <% unless local_assigns[:hide_activity] %>
          <%= render "messages/activity", message: message %>
        <% end %>

        <div id="<%= dom_id(message) %>_body"
             class="chat-content"><%= markdown(message.content) %></div>

        <%= render "messages/artifacts", message: message %>

        <% if message.streaming? || message.pending? %>
          <%# A just-pending turn seeds the indicator with the predicted
              provisioning phase (the live broadcast races the HTTP render);
              once streaming, the broadcaster drives the phase. %>
          <%= render "messages/streaming_indicator", message: message,
                phase: (message.pending? ? runtime_initial_phase(message.conversation) : nil) %>
        <% end %>

        <% if message.canceled? %>
          <div class="msg-flag">Stopped</div>
        <% end %>

        <div id="<%= dom_id(message) %>_foot" class="msg-foot">
          <div id="<%= dom_id(message) %>_meta"
               class="msg-meta"><%= message_meta(message) %></div>
          <% if local_assigns[:forkable] && message.done? %>
            <%= render "messages/actions", message: message %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
