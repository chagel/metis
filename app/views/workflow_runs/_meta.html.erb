<%# Root id is the broadcast/replace target. %>
<span id="workflow_meta" class="wf-meta">
  <% if run.workflow %>
    <%= link_to edit_workflow_path(run.workflow), class: "tag wf-meta-name" do %>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4h5l1 1.5h5M2.5 4v8h11V5.5M2.5 8h11"/></svg>
      <%= run.workflow.name %>
    <% end %>
  <% else %>
    <span class="tag wf-meta-name"><%= t(".workflow") %></span>
  <% end %>
  <span class="wf-meta-stats">
    <%= t(".steps", count: run.tasks.size) %>
    · <%= t(".gates", count: run.tasks.approval.count) %>
    · <%= t(".agent_duration", duration: wf_compact_duration(run.agent_seconds)) %>
    <% if run.settled_at %> <%= t(".wall_duration", duration: wf_compact_duration(run.settled_at - run.created_at)) %><% end %>
    <% if run.total_cost.positive? %> <%= t(".cost", cost: format_cost(run.total_cost)) %><% end %>
  </span>
  <span class="tag wf-meta-state wf-meta-state--<%= run.status %>"><%= wf_run_status_label(run) %></span>
</span>
