<%# Root id is the broadcast/replace target. %>
<div id="workflow_rail" class="wf-rail-wrap" data-status="<%= run.status %>">
  <div class="wf-rail">
    <% run.tasks.each_with_index do |task, i| %>
      <% state = wf_step_state(task) %>
      <div class="wf-step <%= state %>">
        <div class="wf-node">
          <% case state %>
          <% when "done" %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <% when "current", "running" %>
            <span class="wf-pulse"></span>
          <% when "failed" %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
          <% else %>
            <%= i + 1 %>
          <% end %>
        </div>
        <div class="wf-label">
          <%= task.name.presence || "Step #{i + 1}" %>
          <% if task.approval? && !task.completed? %><span class="wf-gate-tag">gate</span><% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
