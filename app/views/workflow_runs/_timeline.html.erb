<%# The run page's audit timeline: one card per event — trigger, each
    step's turn, and each gate decision. "view turn →" jumps into the
    chat anchored at that step's message. Root id is the
    broadcast/replace target; request-safe (run + conversation only). %>
<div id="workflow_timeline">
<div class="wf-tl">
  <div class="wf-tl-item">
    <div class="wf-tl-node done">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
    </div>
    <div class="wf-tl-card">
      <div class="wf-tl-top">
        <h3 class="wf-tl-title">Triggered</h3>
        <span class="wf-tl-time"><%= wf_trigger_stamp(run.created_at) %></span>
      </div>
      <p class="wf-tl-body">
        <%= run.trigger_summary %>
        <% if run.workflow %> · workflow <b><%= run.workflow.name %></b><% end %>
        <% if conversation.runtime_label %> · runtime <%= conversation.runtime_label %><% end %>
      </p>
    </div>
  </div>

  <% run.tasks.each_with_index do |task, index| %>
    <% message = task.assistant_message %>
    <% state = wf_step_state(task) %>
    <div class="wf-tl-item <%= state.presence || "pending" %>">
      <div class="wf-tl-node <%= state %>">
        <% case state %>
        <% when "done" %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        <% when "failed" %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        <% when "running", "current" %>
          <span class="wf-pulse"></span>
        <% else %>
          <%= index + 1 %>
        <% end %>
      </div>
      <div class="wf-tl-card">
        <div class="wf-tl-top">
          <h3 class="wf-tl-title"><%= task.name.presence || "Step #{index + 1}" %></h3>
          <span class="wf-tl-time">
            <% if (window = wf_turn_window(message)) %>
              <%= window %>
            <% elsif task.delegated? && task.running? %>
              <span class="wf-tl-running"><%= wf_local_label(run) %></span>
            <% elsif task.running? %>
              <span class="wf-tl-running">Running</span>
            <% end %>
          </span>
        </div>
        <% if message && (message.pending? || message.streaming?) %>
          <%# The in-flight turn, live: these are the same id-addressed
              regions the chat renders, so ChatBroadcaster's reasoning,
              text-delta, and phase streams land here unchanged. The next
              timeline refresh swaps this for the finished summary. %>
          <div class="wf-tl-live">
            <%= render "messages/activity", message: message %>
            <div id="<%= dom_id(message) %>_body" class="chat-content"><%= markdown(message.content) %></div>
            <%= render "messages/streaming_indicator", message: message,
                  phase: (message.pending? ? runtime_initial_phase(conversation) : nil) %>
          </div>
        <% else %>
          <% summary = task.delegated? ? task.result_summary : message&.content %>
          <% if summary.present? %>
            <%# Snippets are prose: render the markdown, drop the markup. %>
            <p class="wf-tl-body"><%= truncate(strip_tags(markdown(summary)).squish, length: 180) %></p>
          <% end %>
        <% end %>
        <% if task.delegated? && task.running? && task.claimed_by_user.nil? %>
          <div class="wf-tl-localguide">
            <p>
              This step runs on one of your machines. In your coding agent there, say
              <button type="button" class="wf-tl-claim" title="Copy"
                      data-controller="copy" data-copy-text-value="claim next task"
                      data-action="copy#copy">
                claim next task
                <svg class="ico-copy" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"/>
                  <path d="M3.4 10.5A1.4 1.4 0 0 1 2.5 9.2V3.6A1.4 1.4 0 0 1 3.9 2.2h5.3a1.4 1.4 0 0 1 1.3.9"/>
                </svg>
                <svg class="ico-check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3.5 8.4l3 3 6-6.2"/>
                </svg>
              </button>
            </p>
            <p class="wf-tl-localguide-sub">
              No agent picking it up? Set up the bridge in
              <%= link_to "account settings", account_path %> — token, MCP
              endpoint, and the skill install live there.
            </p>
          </div>
        <% end %>
        <% if message && (message.model_key.present? || token_summary(message).present? || message.cost&.positive?) %>
          <div class="wf-tl-meta">
            <% if message.model_key.present? %><span class="tag"><%= message.model_key %></span><% end %>
            <% if token_summary(message).present? %><span class="tag"><%= token_summary(message) %></span><% end %>
            <% if message.cost&.positive? %><span class="tag"><%= format_cost(message.cost) %></span><% end %>
            <%= link_to "view turn →",
                  conversation_path(conversation, view: "chat", turn: message.id),
                  class: "wf-tl-turnlink" %>
          </div>
        <% end %>
      </div>
    </div>

    <% if run.awaiting_approval? && task.awaiting_approval? %>
      <div class="wf-tl-item gate">
        <div class="wf-tl-node gate">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        </div>
        <div class="wf-tl-gate-inline"><%= render "workflow_runs/gate", run: run %></div>
      </div>
    <% end %>

    <% if task.approval? && task.decided_at %>
      <div class="wf-tl-item gate">
        <div class="wf-tl-node gate">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
        </div>
        <div class="wf-tl-card">
          <div class="wf-tl-top">
            <h3 class="wf-tl-title">Gate · <%= task.name.presence || "review" %></h3>
            <% if message&.finished_at %>
              <span class="wf-tl-time">paused <%= wf_compact_duration(task.decided_at - message.finished_at) %></span>
            <% end %>
          </div>
          <div class="wf-tl-gate-by">
            <% if task.approved_by %>
              <%= avatar_for task.approved_by, size: 20, css: "wf-tl-gate-avatar" %>
              <span><%= task.approved_by.display_label %></span>
            <% else %>
              <span>The reviewer</span>
            <% end %>
            · <%= task.rejected? ? "rejected" : "approved" %>
            <span class="tag"><%= task.decided_at.strftime("%-l:%M %p") %></span>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

</div>
