<%# The run page's audit timeline: one card per event — trigger, each
    step's turn, and each gate decision. "view turn →" jumps into the
    chat anchored at that step's message. Root id is the
    broadcast/replace target; request-safe (run + conversation only).
    `auto_claim` decides the unclaimed-local branch — the viewer's own
    preference on a request, defaults to manual on broadcasts (broadcasts
    have no current_user, so showing the Claim button is safe for all). %>
<% auto_claim = local_assigns.fetch(:auto_claim, false) %>
<div id="workflow_timeline">
<div class="wf-tl">
  <div class="wf-tl-item">
    <div class="wf-tl-node done">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
    </div>
    <div class="wf-tl-card">
      <div class="wf-tl-top">
        <h3 class="wf-tl-title"><%= t(".triggered") %></h3>
        <span class="wf-tl-time"><%= wf_trigger_stamp(run.created_at) %></span>
      </div>
      <p class="wf-tl-body">
        <%= run.trigger_summary %>
        <% if run.workflow %> <%= t(".workflow_prefix") %> <b><%= run.workflow.name %></b><% end %>
        <% if conversation.runtime_label %> <%= t(".runtime_label", runtime: conversation.runtime_label) %><% end %>
      </p>
      <% if run.input.present? %>
        <div class="wf-tl-quote chat-content"><%= markdown(run.input) %></div>
      <% end %>
    </div>
  </div>

  <% run.tasks.each_with_index do |task, index| %>
    <% message = task.assistant_message %>
    <% state = wf_step_state(task) %>
    <div class="wf-tl-item <%= state.presence || "pending" %>">
      <div class="wf-tl-node <%= state %>">
        <% case state %>
        <% when "done" %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        <% when "failed" %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        <% when "running", "current" %>
          <span class="wf-pulse"></span>
        <% else %>
          <%= index + 1 %>
        <% end %>
      </div>
      <div class="wf-tl-card">
        <div class="wf-tl-top">
          <h3 class="wf-tl-title"><%= task.name.presence || t(".step_number", number: index + 1) %></h3>
          <span class="wf-tl-time">
            <% if (window = wf_turn_window(message)) %>
              <%= window %>
            <% elsif task.delegated? && task.running? %>
              <span class="wf-tl-running"><%= wf_local_label(run) %></span>
            <% elsif task.running? %>
              <span class="wf-tl-running"><%= t(".running") %></span>
            <% end %>
          </span>
        </div>
        <% if message && (message.pending? || message.streaming?) %>
          <%# The in-flight turn, live: these are the same id-addressed
              regions the chat renders, so ChatBroadcaster's reasoning,
              text-delta, and phase streams land here unchanged. The next
              timeline refresh swaps this for the finished summary. %>
          <div class="wf-tl-live">
            <%= render "messages/activity", message: message %>
            <div id="<%= dom_id(message) %>_body" class="chat-content"><%= markdown(message.content) %></div>
            <%= render "messages/streaming_indicator", message: message,
                  phase: (message.pending? ? runtime_initial_phase(conversation) : nil) %>
          </div>
        <% elsif task.delegated? && task.result_summary.present? %>
          <%# A delegated step's result has no turn to view — the summary
              is the deliverable, so it renders in full (scroll-capped). %>
          <div class="wf-tl-result chat-content"><%= markdown(task.result_summary) %></div>
        <% elsif message&.content.present? %>
          <%# Cloud snippets are prose: render the markdown, drop the
              markup — the full turn is one click away. %>
          <p class="wf-tl-body"><%= truncate(strip_tags(markdown(message.content)).squish, length: 180) %></p>
        <% end %>
        <% if task.delegated? && task.running? && task.claimed? %>
          <%# Claim → first heartbeat is minutes of silence; the ticker
              shows the step is alive meanwhile. Same controller as the
              chat's streaming indicator. %>
          <div class="wf-tl-live">
            <% if (latest = task.progress.last) %>
              <p class="wf-tl-body"><%= latest["text"] %></p>
            <% end %>
            <% if task.claimed_at %>
              <div class="working-status"
                   data-controller="elapsed-timer"
                   data-elapsed-timer-started-at-value="<%= task.claimed_at.to_i * 1000 %>">
                <span class="msg-indicator" aria-hidden="true">&#x25CF;</span>
                <span class="working-label" data-elapsed-timer-target="label" role="status" aria-live="polite"></span>
              </div>
            <% end %>
          </div>
        <% elsif task.delegated? && task.running? %>
          <div class="wf-tl-localguide">
            <% if auto_claim %>
              <p><%= t(".local_runs_html") %></p>
              <p class="wf-tl-localguide-sub">
                <%= t(".nothing_html", link: link_to(t(".account_settings"), account_path)) %>
              </p>
            <% else %>
              <p><%= t(".local_runs_manual_html", link: link_to(t(".account_settings"), account_path)) %></p>
              <%= button_to t(".claim_step"), workflow_run_claim_run_task_path(run, task),
                    method: :post, class: "wf-tl-claim-btn", form: { data: { turbo_frame: "_top" } } %>
              <p class="wf-tl-claim-hint"><%= t(".claim_step_hint") %></p>
            <% end %>
          </div>
        <% end %>
        <% if task.delegated? && (task.result_agent || task.result_model) %>
          <%# The machine owner picks the model; Metis acknowledges what ran. %>
          <div class="wf-tl-meta">
            <% if task.result_agent %><span class="tag"><%= task.result_agent %></span><% end %>
            <% if task.result_model %><span class="tag"><%= task.result_model %></span><% end %>
            <% if task.claimed_label %><span class="tag"><%= task.claimed_label %></span><% end %>
          </div>
        <% end %>
        <% if message && (message.model_key.present? || token_summary(message).present? || message.cost&.positive?) %>
          <div class="wf-tl-meta">
            <% if message.model_key.present? %><span class="tag"><%= message.model_key %></span><% end %>
            <% if token_summary(message).present? %><span class="tag"><%= token_summary(message) %></span><% end %>
            <% if message.cost&.positive? %><span class="tag"><%= format_cost(message.cost) %></span><% end %>
            <%= link_to t(".view_turn"),
                  conversation_path(conversation, view: "chat", turn: message.id),
                  class: "wf-tl-turnlink" %>
          </div>
        <% end %>
      </div>
    </div>

    <% if run.awaiting_approval? && task.awaiting_approval? %>
      <div class="wf-tl-item gate">
        <div class="wf-tl-node gate">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        </div>
        <div class="wf-tl-gate-inline"><%= render "workflow_runs/gate", run: run %></div>
      </div>
    <% end %>

    <% if task.approval? && task.decided_at %>
      <div class="wf-tl-item gate">
        <div class="wf-tl-node gate">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
        </div>
        <div class="wf-tl-card">
          <div class="wf-tl-top">
            <h3 class="wf-tl-title"><%= t(".gate_title", name: task.name.presence || t(".gate_review")) %></h3>
            <% if message&.finished_at %>
              <span class="wf-tl-time"><%= t(".paused_duration", duration: wf_compact_duration(task.decided_at - message.finished_at)) %></span>
            <% end %>
          </div>
          <div class="wf-tl-gate-by">
            <% if task.approved_by %>
              <%= avatar_for task.approved_by, size: 20, css: "wf-tl-gate-avatar" %>
              <span><%= task.approved_by.display_label %></span>
            <% else %>
              <span><%= t(".the_reviewer") %></span>
            <% end %>
            · <%= task.rejected? ? t(".rejected") : t(".approved") %>
            <span class="tag"><%= task.decided_at.strftime("%-l:%M %p") %></span>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

</div>
