<h1 style="margin:0 0 16px; font-size:20px; line-height:28px; font-weight:700; color:#1c1917;">
  <%= t(".heading", team: @team.name) %>
</h1>

<p style="margin:0 0 24px; font-size:15px; line-height:24px; color:#44403c;">
  <%= t(".body_html", inviter: tag.strong(@inviter.display_label), team: tag.strong(@team.name), role: tag.strong(@invitation.role)) %>
</p>

<%= render "email/cta", url: @accept_url, label: t(".accept") %>

<hr style="border:none; border-top:1px solid #e7e5e4; margin:0 0 20px;">

<p style="margin:0; font-size:13px; line-height:20px; color:#a8a29e;">
  <%= t(".expires", date: @invitation.expires_at.to_date.to_fs(:long)) %>
</p>
