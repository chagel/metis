<% content_for :title, "Models" %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title">Models</h1>
    <div style="flex:1"></div>
    <% if current_user.superuser? %>
      <%# Turbo swaps the label to "Refreshing…" and disables the button for
          the whole request — the sync spawns pi (docker run / E2b microVM),
          which can take a while. %>
      <%= button_to "Refresh", refresh_models_path, class: "btn btn-ghost",
            data: { turbo_submits_with: "Refreshing…" } %>
    <% end %>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <p class="models-intro">
        The providers and models this deployment offers in the new-chat composer.
        <%= current_user.superuser? ? "Refresh to pull the latest from pi, then toggle on what you want." : "Managed by an administrator." %>
      </p>

      <%# Enable/disable and set-default submit inside this frame, so Turbo
          swaps just the list — derived provider state and the moved default
          badge re-render without a full-page reload. %>
      <%= turbo_frame_tag "models-catalog" do %>
        <% if @providers.empty? %>
          <div class="pane-empty">
            <p>The catalog is empty.</p>
            <% if current_user.superuser? %>
              <p>Click <strong>Refresh</strong> to populate it from pi.</p>
            <% else %>
              <p>An administrator hasn't populated it yet.</p>
            <% end %>
          </div>
        <% else %>
          <% @providers.each do |provider| %>
            <%= render "provider", provider: provider %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</main>
