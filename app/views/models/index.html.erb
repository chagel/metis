<% content_for :title, t('.title') %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title"><%= t('.heading') %></h1>
    <div style="flex:1"></div>
    <% if current_user.superuser? %>
      <%# Turbo swaps the label to "Refreshing…" and disables the button for
          the whole request — the sync spawns pi (docker run / E2b microVM),
          which can take a while. %>
      <%= button_to t('.refresh'), refresh_models_path, class: "btn btn-ghost",
            data: { turbo_submits_with: t('.refreshing') } %>
    <% end %>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <p class="models-intro">
        <%= t('.intro') %>
        <%= current_user.superuser? ? t('.intro_superuser') : t('.intro_managed') %>
      </p>

      <%# Enable/disable and set-default submit inside this frame, so Turbo
          swaps just the list — derived provider state and the moved default
          badge re-render without a full-page reload. %>
      <%= turbo_frame_tag "models-catalog" do %>
        <% if @providers.empty? %>
          <div class="pane-empty">
            <p><%= t('.empty') %></p>
            <% if current_user.superuser? %>
              <p><%= t('.empty_refresh_html', refresh: tag.strong(t('.refresh'))) %></p>
            <% else %>
              <p><%= t('.empty_managed') %></p>
            <% end %>
          </div>
        <% else %>
          <div class="models-default">
            <span class="models-default-label"><%= t('.default_label') %></span>
            <% if current_user.superuser? %>
              <%= form_with url: models_default_path, method: :patch, data: { controller: "auto-submit" } do %>
                <%= select_tag :model_id,
                      grouped_options_for_select(@default_options, @default&.id),
                      include_blank: @default ? nil : t('.default_none', model: @fallback_label),
                      class: "team-input", data: { action: "change->auto-submit#submit" } %>
              <% end %>
            <% else %>
              <span><%= @default&.label || t('.default_none', model: @fallback_label) %></span>
            <% end %>
            <span class="models-default-hint"><%= t('.default_hint') %></span>
          </div>
          <% @providers.each do |provider| %>
            <%= render "provider", provider: provider %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</main>
