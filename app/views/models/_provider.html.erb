<%# provider: an LlmProvider %>
<% models = provider.llm_models.sort_by { |model| [ model.position, model.key ] } %>
<% enabled_count = models.count(&:enabled?) %>
<section class="model-provider <%= 'is-off' unless provider.enabled? %>">
  <header class="model-provider-head">
    <div class="model-provider-id">
      <h2 class="model-provider-name"><%= provider.label %></h2>
      <div class="model-provider-sub">
        <code class="model-key"><%= provider.key %></code>
        <span class="model-count"><%= enabled_count %> of <%= models.size %> enabled</span>
        <% unless provider.api_key? %>
          <span class="badge badge-warn" title="No API key is configured for this provider; its models won't run.">no API key</span>
        <% end %>
      </div>
    </div>

    <% if current_user.superuser? %>
      <%= button_to "", model_provider_path(provider), method: :patch,
            params: { enabled: !provider.enabled? }, form_class: "inline-form",
            class: "switch switch-lg #{'is-on' if provider.enabled?}",
            title: provider.enabled? ? "Disable all #{provider.label} models" : "Enable #{provider.label}",
            aria: { label: provider.enabled? ? "Disable #{provider.label}" : "Enable #{provider.label}" } %>
    <% else %>
      <span class="status-pill <%= 'is-on' if provider.enabled? %>"><%= provider.enabled? ? "On" : "Off" %></span>
    <% end %>
  </header>

  <ul class="model-list">
    <% models.each do |model| %>
      <li class="model-row <%= 'is-off' unless model.enabled? %>">
        <div class="model-main">
          <div class="model-head">
            <span class="model-label"><%= model.label %></span>
            <% if model.last_seen_at.nil? %>
              <span class="badge badge-warn" title="Not reported by pi on the last refresh.">stale</span>
            <% end %>
          </div>
          <div class="model-meta">
            <code class="model-key"><%= model.key %></code>
            <% if model.context_window.present? %><span class="model-tag"><%= model.context_window / 1000 %>K context</span><% end %>
            <% if model.reasoning? %><span class="model-tag">reasoning</span><% end %>
            <% if model.input_modalities.present? %><span class="model-tag"><%= model.input_modalities.join(" · ") %></span><% end %>
          </div>
        </div>

        <div class="model-actions">
          <% if current_user.superuser? %>
            <%= button_to "", model_item_path(model), method: :patch,
                  params: { enabled: !model.enabled? }, form_class: "inline-form",
                  class: "switch #{'is-on' if model.enabled?}",
                  title: model.enabled? ? "Disable #{model.label}" : "Enable #{model.label}",
                  aria: { label: model.enabled? ? "Disable #{model.label}" : "Enable #{model.label}" } %>
          <% else %>
            <span class="status-pill <%= 'is-on' if model.enabled? %>"><%= model.enabled? ? "On" : "Off" %></span>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
</section>
