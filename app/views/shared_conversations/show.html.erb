<% content_for :title, @conversation.display_title %>

<% content_for :head do %>
  <% share_url   = shared_conversation_url(@conversation.share_token) %>
  <% share_title = @conversation.display_title %>
  <% share_desc  = share_description(@conversation) %>
  <% share_image = share_image_url(@conversation) %>

  <meta name="description" content="<%= share_desc %>">
  <link rel="canonical" href="<%= share_url %>">

  <%# Open Graph — Slack, iMessage, WhatsApp, Discord, LinkedIn, Facebook %>
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="Metis">
  <meta property="og:title" content="<%= share_title %>">
  <meta property="og:description" content="<%= share_desc %>">
  <meta property="og:url" content="<%= share_url %>">
  <meta property="og:image" content="<%= share_image %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="<%= share_title %>">

  <%# Twitter / X %>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= share_title %>">
  <meta name="twitter:description" content="<%= share_desc %>">
  <meta name="twitter:image" content="<%= share_image %>">
<% end %>

<header class="shared-head">
  <div class="shared-head-inner">
    <a class="shared-brand" href="<%= root_path %>" target="_blank" rel="noopener">
      <span class="shared-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 18.5V7l7 6.5 7-6.5v11.5"/>
        </svg>
      </span>
      <span class="shared-word">Metis</span>
    </a>
    <h1 class="shared-title"><%= @conversation.display_title %></h1>
    <% if (run = @conversation.workflow_run) %>
      <span class="wf-meta">
        <span class="tag wf-meta-name">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4h5l1 1.5h5M2.5 4v8h11V5.5M2.5 8h11"/></svg>
          <%= run.workflow&.name || "Workflow" %>
        </span>
        <span class="tag wf-meta-state wf-meta-state--<%= run.status %>"><%= wf_run_status_label(run) %></span>
      </span>
    <% end %>
    <% author = @conversation.user %>
    <% if author %>
      <div class="shared-author">
        <%= avatar_for author, size: 24, css: "shared-author-avatar" %>
        <span class="shared-author-name"><%= author.display_label %></span>
        <span class="shared-author-dot" aria-hidden="true">·</span>
        <span class="shared-author-time">Shared <%= time_ago_in_words(@conversation.updated_at) %> ago</span>
      </div>
    <% else %>
      <div class="shared-sub">Shared <%= time_ago_in_words(@conversation.updated_at) %> ago</div>
    <% end %>
  </div>
</header>

<% if (run = @conversation.workflow_run) %>
  <%= render "workflow_runs/rail", run: run %>
<% end %>

<main class="shared">
  <div class="shared-stream">
    <div class="thread">
      <%= render partial: "messages/message",
            collection: @messages,
            as: :message,
            locals: { hide_activity: true } %>
    </div>
  </div>
</main>

<footer class="shared-foot">
  <div class="shared-foot-inner">
    Powered by <a href="<%= root_url %>" target="_blank" rel="noopener">Metis</a>
  </div>
</footer>
