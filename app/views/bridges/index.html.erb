<% content_for :title, "Bridge" %>

<main class="pane">
  <header class="pane-head">
    <h1 class="pane-title">Bridge</h1>
  </header>

  <div class="pane-body">
    <div class="pane-inner">
      <p class="pane-lead">
        Enroll a local machine so a workflow can delegate a step to a coding
        agent running on your own computer — against your real repo, with your
        own toolchain and credentials. Enroll once, then connect it from your
        terminal.
      </p>

      <% if @new_token.present? %>
        <div class="bridge-token">
          <div class="bridge-token-label">Enrollment token — <%= @device.name %></div>
          <p class="bridge-token-hint">
            Copy it now; it won't be shown again. On your machine, run
            <code>metis bridge login</code> and paste it (or add it to your
            <code>.mcp.json</code>).
          </p>
          <div class="token-row">
            <code class="token"><%= @new_token %></code>
            <button type="button" class="token-copy" title="Copy token"
                    aria-label="Copy token to clipboard"
                    data-controller="copy"
                    data-copy-text-value="<%= @new_token %>"
                    data-action="copy#copy">
              <svg class="ico-copy" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"/>
                <path d="M3.4 10.5A1.4 1.4 0 0 1 2.5 9.2V3.6A1.4 1.4 0 0 1 3.9 2.2h5.3a1.4 1.4 0 0 1 1.3.9"/>
              </svg>
              <svg class="ico-check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3.5 8.4l3 3 6-6.2"/>
              </svg>
              <span class="lbl-copy">Copy</span>
              <span class="lbl-done">Copied</span>
            </button>
          </div>
        </div>
      <% end %>

      <% if team_manager? %>
        <%= form_with model: @device, url: bridges_path, method: :post, class: "conn-form" do |f| %>
          <% if @device.errors.any? %>
            <div class="flash error"><%= @device.errors.full_messages.to_sentence %></div>
          <% end %>
          <div class="field">
            <%= f.label :name, "Device name" %>
            <%= f.text_field :name, placeholder: "macbook-pro", autocomplete: "off" %>
            <p class="field-hint">A name you'll recognize — your laptop's hostname works.</p>
          </div>
          <div class="field">
            <%= f.label :agent_kind, "Agent" %>
            <%= f.select :agent_kind,
                  [ [ "pi", "pi" ], [ "Claude Code", "claude-code" ], [ "Codex", "codex" ] ],
                  include_blank: "Any agent" %>
            <p class="field-hint">Which coding agent this machine runs. Leave as Any to choose per run.</p>
          </div>
          <div class="form-actions">
            <%= f.submit "Enroll device", class: "btn btn-primary" %>
          </div>
        <% end %>
      <% end %>

      <h2 class="settings-card-sub">Enrolled devices</h2>
      <% if @devices.any? %>
        <div class="conn-list">
          <%= render partial: "device", collection: @devices %>
        </div>
      <% else %>
        <div class="pane-empty">
          <p>No devices enrolled yet. Enroll one above, then connect it from your machine.</p>
        </div>
      <% end %>
    </div>
  </div>
</main>
