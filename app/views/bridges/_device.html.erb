<div class="conn-row">
  <div class="conn-main">
    <div class="conn-name">
      <%= device.name %>
      <span class="dev-dot <%= "on" if device.online? %>"
            title="<%= device.online? ? "Online" : "Offline" %>"></span>
    </div>
    <div class="conn-sub">
      <%= device.agent_kind.presence || "any agent" %> ·
      <%= device.last_seen_at ? "last seen #{time_ago_in_words(device.last_seen_at)} ago" : "never connected" %>
    </div>
  </div>
  <% if team_manager? %>
    <%= button_to "Revoke", bridge_path(device), method: :delete, class: "btn btn-ghost",
          form: { data: { turbo_confirm: "Revoke #{device.name}? Its token stops working immediately." } } %>
  <% end %>
</div>
