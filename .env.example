# --- GitHub App authentication + connectors ---
# See docs/connectors.md
#
# Create a GitHub App (Settings → Developer settings → GitHub Apps):
#   - App name: anything (e.g. metis-dev)
#   - Homepage URL: your deployment URL
#   - Callback URL: https://<your-host>/users/auth/github/callback
#   - Setup URL (optional): https://<your-host>/
#   - Webhook: inactive (Metis doesn't consume webhooks)
#   - Permissions:
#       Repository:
#         Contents: Read & write
#         Pull requests: Read & write
#         Issues: Read & write
#         Metadata: Read-only (auto-granted)
#       Account:
#         Email addresses: Read-only
#   - User-to-server token expiration: ENABLED (Settings → Optional features;
#     without it GitHub issues no refresh token and renewals fail).
#   - Generate a client secret after creation and copy both the client id
#     and the secret below.
#
#   GITHUB_APP_CLIENT_ID       the App's Client ID
#   GITHUB_APP_CLIENT_SECRET   the App's client secret (the generated one,
#                              not the OAuth "Client secret" shown above it)
#   GITHUB_APP_SLUG            the part after apps/ in the App's public URL
#                              (e.g. metis-dev for github.com/apps/metis-dev).
#                              Optional, but needed for the install redirect
#                              that sends users to install the App on their
#                              repos after the connect flow.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=

# --- GitHub App server-to-server (bot) ---
# The bot token (installation access token) lets the agent act as the
# GitHub App itself (`<slug>[bot]`) rather than as a member — used for
# PR reviews (GitHub forbids approving your own PR, so the personal
# `github` connector can only comment). Enables the `github_bot` MCP
# server. See docs/connectors.md, app/services/github_app/.
#
#   GITHUB_APP_ID              numeric App ID (Settings → General → App ID).
#                              Drives the server-to-server JWT signing.
#
#   GITHUB_APP_PRIVATE_KEY     the App's RSA private key (PEM), from the
#                              App settings page, base64-encoded to ONE
#                              line:  base64 < key.pem | tr -d '\n'
#                              (pasting the raw multiline PEM breaks dotenv).
#   GITHUB_APP_INSTALLATION_ID optional — deployment-wide default
#                              installation for github_bot tokens. Each
#                              team can pick its own on the connector's
#                              manage page (takes precedence). Auto-resolved
#                              when the App has a single installation.
#                              See docs/connectors.md.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# --- Google sign-in + Google Workspace connectors (OAuth) ---
# Create an OAuth 2.0 client in Google Cloud (APIs & Services > Credentials):
#   - Application type: Web application
#   - Authorized redirect URI: https://<your-host>/users/auth/google_oauth2/callback
#   - Add the following scopes (APIs & Services > OAuth consent screen):
#       .../auth/userinfo.email
#       .../auth/userinfo.profile
#       .../auth/calendar
#       .../auth/gmail.modify
#       .../auth/drive.file
#   - Publish the app (or add test users) so non-test-account users can
#     connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM providers ---
# At least one is required. Provider keys are deployment-level — not
# per-user. See docs/providers.md.
#
#   ANTHROPIC_API_KEY
#   OPENAI_API_KEY
#   GEMINI_API_KEY (pi's name for Google — not GOOGLE_API_KEY)
#   DEEPSEEK_API_KEY
#   XAI_API_KEY
#
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- LLM observability (Langfuse, optional) ---
# See docs/observability.md
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Email (optional) ---
# SMTP credentials for sending emails (password resets, invitations, etc.)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Active Record encryption (required) ---
# Generate with: bin/rails db:encryption:init
# Must be identical across all app instances.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=

# --- Active Storage (S3-compatible) ---
# Required for user file uploads and agent-generated artifacts.
# See config/storage.yml
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_REGION=
AWS_ENDPOINT=

# --- E2B sandbox (optional) ---
# Required for e2b runtime. Create an API key at https://e2b.dev
E2B_API_KEY=

# --- Daytona sandbox (optional) ---
# Required for daytona runtime.
DAYTONA_API_KEY=
DAYTONA_API_URL=

# --- Linear OAuth (optional) ---
# Create a Linear OAuth app at https://linear.app/settings/api
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# --- Notion internal integration (optional) ---
# Create at https://www.notion.so/profile/integrations
# Must be an internal integration (not a public one).
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- Development / Test ---
# Set to non-empty to skip Devise email confirmation in dev/test.
SKIP_EMAIL_CONFIRMATION=
