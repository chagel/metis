# --- GitHub App authentication + connectors ---
# See docs/connectors.md
#
# Create a GitHub App (Settings → Developer settings → GitHub Apps):
#   - App name: anything (e.g. metis-dev)
#   - Homepage URL: your deployment URL
#   - Callback URL: https://<your-host>/users/auth/github/callback
#   - Setup URL (optional): https://<your-host>/
#   - Webhook: inactive (Metis doesn't consume webhooks)
#   - Permissions:
#       Repository:
#         Contents: Read & write
#         Pull requests: Read & write
#         Issues: Read & write
#         Metadata: Read-only (auto-granted)
#       Account:
#         Email addresses: Read-only
#   - User-to-server token expiration: ENABLED (Settings → Optional features;
#     without it GitHub issues no refresh token and renewals fail).
#   - Generate a client secret after creation and copy both the client id
#     and the secret below.
#
#   GITHUB_APP_CLIENT_ID       the App's Client ID
#   GITHUB_APP_CLIENT_SECRET   the App's client secret (the generated one,
#                              not the OAuth "Client secret" shown above it)
#   GITHUB_APP_SLUG            the part after apps/ in the App's public URL
#                              (e.g. metis-dev for github.com/apps/metis-dev).
#                              Optional, but needed for the install redirect
#                              that sends users to install the App on their
#                              repos after the connect flow.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=

# --- GitHub App server-to-server (bot) ---
# The bot token (installation access token) lets the agent act as the
# GitHub App itself (`<slug>[bot]`) rather than as a member — used for
# PR reviews (GitHub forbids approving your own PR, so the personal
# `github` connector can only comment). Enables the `github_bot` MCP
# server. See docs/connectors.md, app/services/github_app/.
#
#   GITHUB_APP_ID              numeric App ID (Settings → General → App ID).
#                              Drives the server-to-server JWT signing.
#
#   GITHUB_APP_PRIVATE_KEY     the App's RSA private key (PEM), from the
#                              App settings page, base64-encoded to ONE
#                              line:  base64 < key.pem | tr -d '\n'
#                              (pasting the raw multiline PEM breaks dotenv).
#   GITHUB_APP_INSTALLATION_ID optional — deployment-wide default
#                              installation for github_bot tokens. Each
#                              team can pick its own on the connector's
#                              manage page (takes precedence). Auto-resolved
#                              when the App has a single installation.
#                              See docs/connectors.md.
#   GITHUB_APP_WEBHOOK_SECRET  the App's webhook Secret (Settings → Webhook).
#                              HMAC key Webhooks::GithubController checks every
#                              inbound delivery against; blank → webhooks are
#                              refused. Generate with: openssl rand -hex 32.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_WEBHOOK_SECRET=

# --- Google sign-in + Google Workspace connectors (OAuth) ---
# Create an OAuth 2.0 client in Google Cloud (APIs & Services > Credentials):
#   - Application type: Web application
#   - Authorized redirect URI: https://<your-host>/users/auth/google_oauth2/callback
#   - Add the following scopes (APIs & Services > OAuth consent screen):
#       .../auth/userinfo.email
#       .../auth/userinfo.profile
#       .../auth/calendar
#       .../auth/gmail.modify
#       .../auth/drive.file
#   - Publish the app (or add test users) so non-test-account users can
#     connect.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# iOS OAuth client (application type: iOS, bundle ID com.metiser.ios) from
# the same Google Cloud project — the accepted ID-token audience for the
# native app's Google sign-in (users/auth/google/native). No secret is
# issued for iOS clients. Must match GIDClientID in metis-ios/project.yml.
GOOGLE_OAUTH_IOS_CLIENT_ID=

# --- LLM providers ---
# At least one is required. Provider keys are deployment-level — not
# per-user. See docs/providers.md.
#
#   ANTHROPIC_API_KEY
#   OPENAI_API_KEY
#   GEMINI_API_KEY (pi's name for Google — not GOOGLE_API_KEY)
#   DEEPSEEK_API_KEY
#   XAI_API_KEY
#   MOONSHOT_API_KEY (Kimi — shared by the moonshotai and moonshotai-cn providers)
#
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Web search (optional) ---
# Backend for the agent's web_search tool (web-tools extension). The first
# configured provider wins: Serper > Brave > SearXNG, else keyless DuckDuckGo.
# DuckDuckGo rate-limits datacenter IPs, so set Serper or Brave for reliable
# search from the sandbox runtimes. See docs/configuration.md#web-search
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARXNG_URL=

# --- LLM observability (Langfuse, optional) ---
# See docs/observability.md
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Email (optional) ---
# Transactional email: team invitations and password resets.
# METIS_MAIL_DELIVERY picks the transport: "smtp" (production default)
# or "cloudflare". Development defaults to "test" (mail collected in
# memory, not sent).
# See docs/configuration.md#email--account-access
METIS_MAIL_DELIVERY=
#
# smtp — any provider (SES, Mailgun, Postmark, a corporate relay):
#   SMTP_ADDRESS          server hostname, e.g. smtp.mailgun.org
#   SMTP_PORT             default 587
#   SMTP_USERNAME / SMTP_PASSWORD   blank → connect without AUTH
#   SMTP_DOMAIN           HELO domain, only if your provider requires it
#   SMTP_AUTHENTICATION   plain (default), login, or cram_md5
#   SMTP_ENABLE_STARTTLS  upgrade to TLS after connect (default true)
#   SMTP_TLS              implicit TLS from byte one, port-465 style
#                         (default false)
SMTP_ADDRESS=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
#
# cloudflare — Cloudflare Email Service (REST API, no SMTP server).
# Account id + a send-scoped API token; the sender domain must be
# verified in that Cloudflare account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
#
# Sender for all outbound mail — an address on a domain your transport
# may send for (e.g. "Metis <noreply@your-domain.com>").
METIS_MAIL_FROM=

# --- Active Storage (S3-compatible) ---
# Required for user file uploads and agent-generated artifacts.
# See config/storage.yml
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_REGION=
AWS_ENDPOINT=

# --- E2B sandbox (optional) ---
# Required for e2b runtime. Create an API key at https://e2b.dev
E2B_API_KEY=

# --- Daytona sandbox (optional) ---
# Required for daytona runtime.
DAYTONA_API_KEY=
DAYTONA_API_URL=

# --- Microsandbox (optional) ---
# For the microsandbox runtime (self-hosted libkrun microVMs). Needs the
# optional bundler group: bundle config set --local with microsandbox
# Image is pulled from an OCI registry (push the docker:image build there).
METIS_MICROSANDBOX_IMAGE=

# --- Linear OAuth app (optional) ---
# One OAuth app per deployment, created at
# https://linear.app/settings/api/applications. It does three jobs:
#   - the project picker reads the member's Linear projects (read scope),
#     so a project binds by name instead of a pasted UUID;
#   - authorizing it subscribes the workspace to the app's webhook;
#   - inbound deliveries land as activity, routed to a team by the payload's
#     organizationId (Webhooks::LinearController). This is the GitHub-App
#     shape — one app, many workspaces.
# App settings:
#   - Redirect URI:  https://<your-host>/settings/connectors/linear/callback
#   - Webhooks:      enable, URL https://<your-host>/webhooks/linear,
#                    and pick the data-change events you want collected.
#   LINEAR_CLIENT_ID       the OAuth app's client id
#   LINEAR_CLIENT_SECRET   the OAuth app's client secret
#   LINEAR_WEBHOOK_SECRET  the app's webhook signing secret (the lin_wh_…
#                          shown on the app page); blank → inbound webhooks
#                          are refused.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# --- X (Twitter) connector OAuth app (optional) ---
# Per-member X connector: Metis brokers the OAuth flow and stages the
# hosted X MCP server (api.x.com/mcp) into conversations with the
# member's bearer. Create an app in the X Developer Portal
# (https://developer.x.com) with OAuth 2.0 enabled, type Web App
# (confidential client). Note X's API plan gates apply — the hosted MCP
# tools need an enrolled developer account.
#   - Callback URI registered on the app must EXACTLY match
#     X_REDIRECT_URI, e.g. https://<your-host>/settings/connectors/x/callback
#   - Scopes requested at connect: tweet.read tweet.write users.read
#     bookmark.read bookmark.write offline.access
# Each key may instead live in Rails credentials (x.client_id,
# x.client_secret, x.redirect_uri); ENV wins per key.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# --- Notion internal integration (optional) ---
# Create at https://www.notion.so/profile/integrations
# Must be an internal integration (not a public one).
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
