# Local environment for `bin/dev` (foreman loads this file automatically).
# Gitignored — safe to put secrets here. Fill in the blank values.

# --- Optional: extra hostname Rails serves in development ---
# Set this if you front the dev server with a custom domain (ngrok,
# Tailscale, your-own.dev, …). Leave blank for localhost-only.
METIS_DEV_HOST=

# --- Agent runtime: where pi runs ---
#   local   = pi as a local subprocess (default; NOT isolated)
#   docker  = pi in a Docker container (namespace-isolated; needs a Docker
#             daemon + image — build with: rake "docker:image[metis-pi]")
#   e2b     = pi inside an E2B microVM (isolated; needs E2B_API_KEY + template)
#   daytona = pi inside a Daytona elastic sandbox (isolated; needs
#             DAYTONA_API_KEY + snapshot — rake "daytona:snapshot[metis-pi]")
METIS_AGENT_RUNTIME=local

# --- Docker runtime (only read when METIS_AGENT_RUNTIME=docker) ---
# Build the image once: rake "docker:image[metis-pi]"
METIS_DOCKER_IMAGE=metis-pi

# --- E2B runtime (only read when METIS_AGENT_RUNTIME=e2b) ---
# Build the template once: rake "e2b:template[metis-pi]"
E2B_API_KEY=
METIS_E2B_TEMPLATE=metis-pi
# How long a paused E2B sandbox sits unused before EvictPausedSandboxesJob
# kills it (the next turn provisions a fresh one). E2B keeps paused
# sandboxes indefinitely with no auto-cleanup, so this knob bounds
# what we pay for inactive conversations. See docs/coding-runtime.md.
METIS_E2B_EVICTION_HOURS=24

# --- Daytona runtime (only read when METIS_AGENT_RUNTIME=daytona) ---
# Build the snapshot once: rake "daytona:snapshot[metis-pi]"
DAYTONA_API_KEY=
METIS_DAYTONA_SNAPSHOT=metis-pi
# Optional: override the Daytona API endpoint / pin a runner region.
# DAYTONA_API_URL=
# DAYTONA_TARGET=
# Idle-lifecycle intervals (minutes), set on the sandbox at create. Unlike e2b
# (free suspend), Daytona bills a stopped sandbox for disk, so these manage
# cost: archive an idle sandbox to cheap storage, then delete it — no metis
# eviction cron. AUTO_STOP is only a crash net for a sandbox left running by a
# killed worker; keep it above the longest turn (≥ METIS_STALLED_TURN_MINUTES)
# or a live turn gets stopped mid-flight. See docs/coding-runtime.md.
METIS_DAYTONA_AUTO_STOP_MINUTES=120
METIS_DAYTONA_AUTO_ARCHIVE_MINUTES=60
METIS_DAYTONA_AUTO_DELETE_MINUTES=1440
# Keep-warm window (seconds): how long the sandbox stays running after a turn
# before the deferred stop (DaytonaStopJob) ends compute billing. A follow-up
# within the window reuses the warm box (no stop, no resume); the cost is idle
# compute for the window. 0 = stop as soon as the job runs (no warm window).
METIS_DAYTONA_KEEP_WARM_SECONDS=120

# --- pi default provider/model ---
# Used when a conversation sets none of its own (the new-chat composer
# normally does). Needed for the e2b / daytona runtimes, whose sandbox has
# no ~/.pi config to fall back on.
METIS_AGENT_PROVIDER=anthropic
METIS_AGENT_MODEL=anthropic/claude-opus-4-8

# --- Provider API keys ---
# pi is passed the key matching the conversation's selected provider.
# Variable names mirror pi's own conventions
# (https://pi.dev/docs/latest/providers) so the same env that runs pi
# locally works here. Set as many as you want available, then click
# Refresh on /settings/models (as an admin): pi reports the models for
# every keyed provider and they appear in the catalog to enable/curate.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
HF_TOKEN=

# --- GitHub connector (GitHub App) ---
# Register a GitHub App at https://github.com/settings/apps/new with:
#   - Callback URL:  <your-app-origin>/users/auth/github/callback
#   - "Expire user authorization tokens": ENABLED (required — otherwise
#     GitHub issues no refresh token and renewals fail when the 8h
#     access token lapses)
#   - Request user authorization (OAuth) during installation: ENABLED
#   - User permissions (Contents R/W, Pull requests R/W, Email read)
# Then paste the client id and client secret here.
#
# IMPORTANT — a GitHub App's user-to-server token can only access
# resources where the App is *installed*. Signing in alone authorizes
# the App as the user's identity but does NOT install it on any repo;
# private repos return 404 until the user clicks "Configure" on the
# App's settings page and grants it access to specific repos (or
# "All repositories"). GITHUB_APP_SLUG (below) lets metis redirect the
# user to the install page automatically after the Connect-GitHub
# flow — leave it blank and the user has to find the install page
# themselves. See docs/connectors.md.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
#
# Server-to-server (installation token) side — OPTIONAL. Only needed for
# the github_bot MCP server, where the agent acts as <slug>[bot] instead
# of as the signed-in user — e.g. agent-authored PR reviews, which GitHub
# won't let you post under the PR author's account. The user-to-server
# keys above are unaffected if you leave these blank.
#   GITHUB_APP_ID              the App's numeric "App ID" (General tab),
#                              distinct from the OAuth client id above.
#   GITHUB_APP_PRIVATE_KEY     a .pem from "Generate a private key" on the
#                              App settings page, base64-encoded to ONE
#                              line:  base64 < key.pem | tr -d '\n'
#                              (pasting the raw multiline PEM breaks dotenv).
#   GITHUB_APP_INSTALLATION_ID optional — which installation to mint for.
#                              Auto-resolved when the App is installed in
#                              one place; set it (numeric id from
#                              GET /app/installations) only with >1.
#                              See docs/connectors.md.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# --- Google sign-in + Google Workspace connectors (OAuth) ---
# Create an OAuth 2.0 client in Google Cloud (APIs & Services > Credentials):
#   - Application type: Web application
#   - Authorized redirect URI: <your-app-origin>/users/auth/google_oauth2/callback
#   - Enable the APIs whose connectors you ship (e.g. Gmail API +
#     Gmail MCP API for the Gmail connector), and add the matching
#     scopes on the OAuth consent screen (gmail.readonly +
#     gmail.compose for Gmail).
# The same client drives "Sign in with Google" AND authorizes the
# Google Workspace connectors — one consent screen, both jobs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Google Workspace connectors (no MCP server) ---
# The Gmail, Calendar, and Drive connectors do not stage an MCP
# server. The agent reaches Google through the `gws` CLI
# (https://github.com/googleworkspace/cli), which the sandbox
# runtimes authorise by exporting GOOGLE_WORKSPACE_CLI_TOKEN with the
# user's Google access token (see app/services/agent/runtime/base.rb).
# Nothing to configure here — the OAuth client id/secret above are
# what the user grants the token through.

# --- Outbound email (Cloudflare Email Service) ---
# Transactional email (team invitations) is sent via Cloudflare Email
# Service's REST API — see Delivery::Cloudflare. Create an API token
# with email-sending permission and verify the sender domain in your
# Cloudflare account. Leaving these blank means development falls back
# to ActionMailer's :test delivery (no real send); production requires
# them. METIS_MAIL_FROM's domain must be the verified sender domain.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
METIS_MAIL_FROM=Metis <noreply@example.com>
# Host used in mailer links (production). A shared dev host uses METIS_DEV_HOST.
METIS_APP_HOST=

# --- Account access ---
# Who may create an account. Every account runs the agent on the
# deployment's shared provider keys, so signup is the access boundary.
#   invite_only — (default) only invitees + the first/bootstrap account
#   open        — anyone may register (trusted-network deployments only)
# The first account is always allowed (bootstrap); grant it superuser via
# `rake superuser:grant[email]` if it needs to curate the model catalog.
METIS_REGISTRATION_MODE=invite_only

# --- File storage (Active Storage) ---
# Uploads default to the local disk, which is per-container and lost on every
# redeploy. In production set AWS_BUCKET to switch to S3 (config/storage.yml
# reads these); the storage service auto-selects S3 once a bucket is set.
# Works with any S3-compatible store — for Cloudflare R2 or MinIO set
# AWS_REGION=auto and AWS_ENDPOINT to the account endpoint.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=
# AWS_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# --- LLM observability (Langfuse, optional) ---
# Export one OpenTelemetry trace per agent turn (model, tokens, cost,
# latency) to Langfuse. Off unless METIS_LANGFUSE_ENABLED is truthy AND both
# keys are set. Per-turn cost/tokens are captured to the database regardless
# (shown in the message footer); this only controls the Langfuse export.
# Create a project at https://cloud.langfuse.com (or self-host) for the keys.
# See docs/observability.md.
METIS_LANGFUSE_ENABLED=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Endpoint — defaults to Langfuse Cloud; set to your self-hosted URL otherwise.
LANGFUSE_HOST=https://cloud.langfuse.com
# Also export prompt/completion + tool I/O text. Off by default because
# Message#content is encrypted at rest — only enable against a Langfuse
# instance you trust with that data (typically self-hosted).
METIS_LANGFUSE_INCLUDE_CONTENT=
