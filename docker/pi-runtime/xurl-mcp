#!/usr/bin/env bash
# Stdio MCP bridge for the X connector. It builds a throwaway 0700 HOME
# with a 0600 .xurl and runs the pinned xurl against the hosted MCP endpoint.
set -euo pipefail

for var in XURL_CLIENT_ID XURL_ACCESS_TOKEN; do
  [[ -n "${!var:-}" ]] || { echo "xurl-mcp: $var is not set" >&2; exit 78; }
done

xurl_home="$(mktemp -d)"
chmod 700 "$xurl_home"
trap 'rm -rf "$xurl_home"' EXIT

quote() { local v=${1//\\/\\\\}; printf '"%s"' "${v//\"/\\\"}"; }

umask 077
cat > "$xurl_home/.xurl" <<EOF
apps:
  metis:
    client_id: $(quote "$XURL_CLIENT_ID")
    default_user: "metis-user"
    oauth2_tokens:
      metis-user:
        type: oauth2
        oauth2:
          access_token: $(quote "$XURL_ACCESS_TOKEN")
          # Metis refreshes between turns. Keep xurl from rotating a token
          # it cannot report back by treating this access token as long-lived.
          expiration_time: 4102444800
default_app: metis
EOF

# Child (not exec) so the EXIT trap still runs; <&0 keeps the JSON-RPC
# stdin that a non-interactive `&` would otherwise point at /dev/null.
HOME="$xurl_home" xurl mcp "${XURL_MCP_URL:-https://api.x.com/mcp}" <&0 &
child=$!
trap 'kill -TERM "$child" 2>/dev/null' HUP INT TERM
wait "$child"
