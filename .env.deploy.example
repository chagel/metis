# Kamal deploy target — host IP and public domain. config/deploy.yml loads
# this file (when present) during ERB rendering so the real values stay out
# of the committed config. Copy to `.env.deploy` (gitignored) and fill in:
#
#   cp .env.deploy.example .env.deploy
#
# These are read by the `kamal` CLI on your machine, NOT injected into the
# app — keep app/runtime config in `.env`.

# Public IP (or DNS name) of the server kamal deploys to.
KAMAL_WEB_IP=
KAMAL_JOB_IP=

# Public hostname Metis serves at. Drives kamal-proxy host routing, the
# mailer/invite link host (METIS_APP_HOST), and the noreply@ sender domain.
METIS_HOST=

# --- Active Storage (S3-compatible) ---
# Bucket + region for uploads and agent artifacts. The access key pair
# lives in production credentials (env.secret), not here.
AWS_BUCKET=
AWS_REGION=

# --- Connector identifiers ---
# Not secret (the App slug is public, the IDs are useless without the secret
# key), but kept here so the committed deploy.yml stays free of deployment
# specifics. The matching secrets live in production credentials.
CLOUDFLARE_ACCOUNT_ID=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_INSTALLATION_ID=

# --- LLM observability (Langfuse, optional) ---
# Non-secret config for the Langfuse export — see docs/observability.md. The
# LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY credentials live in production
# credentials (env.secret), not here. Leave these blank to keep export off
# (deploy.yml defaults them); the export also stays off unless both keys are set.
#   METIS_LANGFUSE_ENABLED          1/true/yes to turn the export on
#   LANGFUSE_HOST                   defaults to https://cloud.langfuse.com
#   METIS_LANGFUSE_INCLUDE_CONTENT  1/true/yes to also export prompt/completion
#                                   text (encrypted at rest — self-hosted only)
METIS_LANGFUSE_ENABLED=
LANGFUSE_HOST=
METIS_LANGFUSE_INCLUDE_CONTENT=

