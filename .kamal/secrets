# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Example of extracting secrets from 1password (or another compatible pw manager)
# SECRETS=$(kamal secrets fetch --adapter 1password --account your-account --from Vault/Item KAMAL_REGISTRY_PASSWORD RAILS_MASTER_KEY)
# KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
# RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY ${SECRETS})

# Example of extracting secrets from Rails credentials
# KAMAL_REGISTRY_PASSWORD=$(rails credentials:fetch kamal.registry_password)

# Use a GITHUB_TOKEN if private repositories are needed for the image
# GITHUB_TOKEN=$(gh config get -h github.com oauth_token)

# Grab the registry password from ENV
# KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Production uses config/credentials/production.yml.enc, encrypted with the
# production.key (not the default master.key). Inject that as RAILS_MASTER_KEY.
RAILS_MASTER_KEY=$(cat config/credentials/production.key)

# Shared-RDS connection URLs (distinct metis_* databases keep us off flakes'
# data). Add these under a `kamal:` key: bin/rails credentials:edit -e production
DATABASE_URL=$(bin/rails credentials:fetch -e production kamal.database_url)
CACHE_DATABASE_URL=$(bin/rails credentials:fetch -e production kamal.cache_database_url)
CABLE_DATABASE_URL=$(bin/rails credentials:fetch -e production kamal.cable_database_url)
QUEUE_DATABASE_URL=$(bin/rails credentials:fetch -e production kamal.queue_database_url)

# Cloudflare Email Service token — stored under `cloudflare:` in production
# credentials (bin/rails credentials:edit -e production).
CLOUDFLARE_EMAIL_API_TOKEN=$(bin/rails credentials:fetch -e production cloudflare.email_api_token)

# Active Storage S3 credentials. Add them under an `aws:` key:
# bin/rails credentials:edit -e production
AWS_ACCESS_KEY_ID=$(bin/rails credentials:fetch -e production aws.access_key_id)
AWS_SECRET_ACCESS_KEY=$(bin/rails credentials:fetch -e production aws.secret_access_key)

# LLM provider keys — pi is handed the one matching the conversation's provider.
# ANTHROPIC_API_KEY is required (deployment default provider). Add the rest you
# want available. Stored under `providers:` in production credentials.
ANTHROPIC_API_KEY=$(bin/rails credentials:fetch -e production providers.anthropic_api_key)
OPENAI_API_KEY=$(bin/rails credentials:fetch -e production providers.openai_api_key)
GEMINI_API_KEY=$(bin/rails credentials:fetch -e production providers.gemini_api_key)
DEEPSEEK_API_KEY=$(bin/rails credentials:fetch -e production providers.deepseek_api_key)
FIREWORKS_API_KEY=$(bin/rails credentials:fetch -e production providers.fireworks_api_key)

# Web-search backend for the agent's web_search tool. The first configured
# provider wins (Serper > Brave), else keyless DuckDuckGo (which rate-limits
# datacenter IPs). Absent keys resolve to empty — safe to leave unset. Store
# under a `search:` key: bin/rails credentials:edit -e production.
SERPER_API_KEY=$(bin/rails credentials:fetch -e production search.serper_api_key)
BRAVE_SEARCH_API_KEY=$(bin/rails credentials:fetch -e production search.brave_search_api_key)

# GitHub connector (GitHub App) — client pair drives sign-in/connector OAuth;
# private key drives the github_bot installation token; webhook secret
# verifies inbound deliveries (Webhooks::GithubController).
GITHUB_APP_CLIENT_ID=$(bin/rails credentials:fetch -e production github.app_client_id)
GITHUB_APP_CLIENT_SECRET=$(bin/rails credentials:fetch -e production github.app_client_secret)
GITHUB_APP_PRIVATE_KEY=$(bin/rails credentials:fetch -e production github.app_private_key)
GITHUB_APP_WEBHOOK_SECRET=$(bin/rails credentials:fetch -e production github.app_webhook_secret)

# Google sign-in + Workspace connectors (one OAuth client does both).
GOOGLE_OAUTH_CLIENT_ID=$(bin/rails credentials:fetch -e production google.oauth_client_id)
GOOGLE_OAUTH_CLIENT_SECRET=$(bin/rails credentials:fetch -e production google.oauth_client_secret)

# E2B runtime — provisions the isolated microVM pi runs in (METIS_AGENT_RUNTIME=e2b).
E2B_API_KEY=$(bin/rails credentials:fetch -e production e2b.api_key)

# Daytona runtime — provisions the elastic sandbox pi runs in (METIS_AGENT_RUNTIME=daytona).
DAYTONA_API_KEY=$(bin/rails credentials:fetch -e production daytona.api_key)

# Langfuse observability — credentials for the per-turn trace export. Add them
# under a `langfuse:` key: bin/rails credentials:edit -e production. Absent keys
# resolve to empty (export stays off), so leaving Langfuse unconfigured is safe.
LANGFUSE_PUBLIC_KEY=$(bin/rails credentials:fetch -e production langfuse.public_key)
LANGFUSE_SECRET_KEY=$(bin/rails credentials:fetch -e production langfuse.secret_key)
